---
title: Creatures - Vintage Story Wiki
layout: layouts/base.njk
permalink: "{{ lang }}/creatures/index.html"
---
{% import "macros/datatable.njk" as dt %}
<h1>Creatures</h1>
<p class="muted">{{ generated.creatures.length }} creatures with known drops/stats. Tags (shown on each creature's own page) are searchable here too.</p>

{% call dt.datatable(60, "Search creatures or tags...", ["Name", "Mod"]) %}
{% for source in generated.creatures | sort(false, false, "sourceDisplayName") %}
  <tr data-search="{{ source.sourceDomain }}:{{ source.sourceCode }} {{ source.entityStats.tags | default([]) | join(' ') }}" data-mod="{{ source.sourceMod }}">
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}creatures/{{ source.sourceDomain }}/{{ source.sourceCode | slugify }}/">{{ source.sourceDisplayName }}</a></td>
    <td><span class="tag">{{ source.sourceMod }}</span></td>
  </tr>
{% endfor %}
{% endcall %}
