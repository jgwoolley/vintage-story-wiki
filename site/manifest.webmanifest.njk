---
permalink: manifest.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": "Vintage Story Wiki",
  "short_name": "VS Wiki",
  "description": "A statically-generated Vintage Story wiki built from the game's own data.",
  "start_url": "{{ ('/' ~ lang ~ '/') | url }}",
  "scope": "{{ '/' | url }}",
  "display": "browser",
  "background_color": "#16130f",
  "theme_color": "#16130f",
  "icons": [
    {"src": "{{ '/' | url }}assets/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "{{ '/' | url }}assets/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "{{ '/' | url }}assets/icon.svg", "sizes": "any", "type": "image/svg+xml"}
  ]
}
