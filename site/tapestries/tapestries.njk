---
pagination:
  data: generated.tapestries
  size: 1
  alias: item
permalink: "{{ lang }}/tapestries/{{ item.domain }}/{{ item.code | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ item.displayName }} - Vintage Story Wiki"
---
<div class="breadcrumb"><a href="{{ ('/' ~ lang ~ '/') | url }}tapestries/">&larr; All tapestries</a></div>

<h1>{{ item.displayName }}</h1>
<p class="muted">
  <code>{{ item.domain }}:{{ item.code }}</code>
  &middot; from <a href="{{ ('/' ~ lang ~ '/') | url }}mods/">{{ item.sourceMod }}</a>
</p>

{% if item.relatedLoreBookId %}
{% set book = generated.lore | findById(item.relatedLoreBookId) %}
<p class="muted">
  Tapestries have no fixed text of their own &mdash; which one of the
  <a href="{{ ('/' ~ lang ~ '/') | url }}lore/{{ book.domain }}/{{ book.code | slugify }}/">"{{ book.title }}"</a>
  book's {{ book.pages.length }} chapters this tapestry shows is picked at placement time, not
  encoded in its block code. Not yet resolved to a specific chapter per placed instance -- see
  <a href="{{ ('/' ~ lang ~ '/') | url }}tools/">Tools</a> for planned follow-up work.
</p>
{% else %}
<p class="muted">No related lore book found for this tapestry.</p>
{% endif %}

<h2>Found in structures ({{ item.foundInStructures.length }})</h2>
{% if item.foundInStructures.length %}
<ul>
  {% for structureId in item.foundInStructures %}
    {% set structure = generated.structures | findById(structureId) %}
    {% if structure %}
    <li><a href="{{ ('/' ~ lang ~ '/') | url }}structures/{{ structure.id | slugify }}/">{{ structure.name or structure.code }}</a> <span class="tag">{{ structure.kind }}</span></li>
    {% endif %}
  {% endfor %}
</ul>
{% else %}
<p class="muted">Not found inside any decoded structure schematic.</p>
{% endif %}
