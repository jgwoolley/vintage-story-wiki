---
pagination:
  data: generated.lore
  size: 1
  alias: book
permalink: "{{ lang }}/lore/{{ book.domain }}/{{ book.code | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ book.title }} - Vintage Story Wiki"
---
{% import "macros/breadcrumb.njk" as bc %}
{{ bc.trail(lang, [{label: "Books & Lore", url: "lore/"}, {label: book.title}]) }}

<h1>{{ book.title }}</h1>
<p class="muted">
  <span class="tag">{{ book.category }}</span>
  <code>{{ book.domain }}:{{ book.code }}</code>
  &middot; from <a href="{{ ('/' ~ lang ~ '/') | url }}mods/">{{ book.sourceMod }}</a>
</p>

{% for page in book.pages %}
  <div class="card" id="chapter-{{ loop.index0 }}">
    {% for subpage in page %}
      <div class="book-page">{{ subpage | lineBreaks | safe }}</div>
      {% if not loop.last %}<hr>{% endif %}
    {% endfor %}
  </div>
{% endfor %}
