---
pagination:
  data: generated.lore
  size: 1
  alias: book
permalink: "{{ lang }}/lore/{{ book.domain }}/{{ book.code | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ book.title }} - Vintage Story Wiki"
---
{% import "macros/breadcrumb.njk" as bc %}
{% import "macros/loretext.njk" as lt %}
{{ bc.trail(lang, [{label: "Lore", url: "lore/"}, {label: book.title}]) }}

<h1>{{ book.title }}</h1>
<p class="muted">
  <a class="tag" href="{{ ('/' ~ lang ~ '/') | url }}lore/?q={{ book.category | urlencode }}">{{ book.category }}</a>
  <code>{{ book.domain }}:{{ book.code }}</code>
  &middot; from <a href="{{ ('/' ~ lang ~ '/') | url }}mods/">{{ book.sourceMod }}</a>
</p>
<p class="muted">These chapters aren't a book you find and read: each is revealed by a tapestry or wallcarving. See <a href="{{ ('/' ~ lang ~ '/') | url }}tapestries/">Tapestries</a> for where each one appears.</p>

{{ lt.pages(book) }}
