---
title: Books & Lore - Vintage Story Wiki
layout: layouts/base.njk
---
{% import "macros/datatable.njk" as dt %}
<h1>Books &amp; Lore</h1>
<p class="muted">{{ generated.lore.length }} readable books/journals/tapestry chapters, with their full in-game text.</p>

{% call dt.datatable(60, "Search books & lore...", ["Title", "Category", "Mod"]) %}
{% for book in generated.lore | sort(false, false, "title") %}
  <tr data-category="{{ book.category }}" data-mod="{{ book.sourceMod }}">
    <td><a href="{{ '/' | url }}lore/{{ book.domain }}/{{ book.code | slugify }}/">{{ book.title }}</a></td>
    <td><span class="tag">{{ book.category }}</span></td>
    <td><span class="tag">{{ book.sourceMod }}</span></td>
  </tr>
{% endfor %}
{% endcall %}
