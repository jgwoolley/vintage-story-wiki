---
description: A statically-generated wiki of Vintage Story crafting recipes, drop rates, structures, decor/clothing, and in-game books, built directly from the game's own data.
---
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Vintage Story Wiki" }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#8a5a2b">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>&#128214;</text></svg>">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Vintage Story Wiki">
  <meta property="og:title" content="{{ title or 'Vintage Story Wiki' }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ siteUrl }}{{ '/' | url }}assets/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {% if siteUrl %}<meta property="og:url" content="{{ siteUrl }}{{ page.url | url }}">{% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or 'Vintage Story Wiki' }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ siteUrl }}{{ '/' | url }}assets/og-image.png">

  <link rel="stylesheet" href="{{ '/' | url }}assets/style.css">
  <script src="{{ '/' | url }}assets/datatable.js" defer></script>
  <script src="{{ '/' | url }}assets/build-time.js" defer></script>
  <script src="{{ '/' | url }}assets/nav.js" defer></script>
  <script src="{{ '/' | url }}assets/layers.js" defer></script>
  {#- Bare-specifier mapping for the vendored Three.js (see eleventy.config.js passthrough). Costs
      nothing on pages that never import it; must precede any <script type="module">. -#}
  <script type="importmap">
    {"imports": {
      "three": "{{ '/' | url }}assets/vendor/three/three.module.min.js",
      "three/addons/": "{{ '/' | url }}assets/vendor/three/addons/"
    }}
  </script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="{{ ('/' ~ lang ~ '/') | url }}">Vintage Story Wiki</a>
    <nav>
      <a href="{{ ('/' ~ lang ~ '/') | url }}items/">Items</a>
      <a href="{{ ('/' ~ lang ~ '/') | url }}recipes/">Recipes</a>
    </nav>
    <div class="nav-dropdown">
      <button type="button" class="nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false">Tools</button>
      <div class="nav-dropdown-panel" hidden>
        <a href="{{ ('/' ~ lang ~ '/') | url }}trades/">Trades price guide</a>
        <a href="{{ ('/' ~ lang ~ '/') | url }}tools/#schematic-vieweruploader">Schematic viewer/uploader <span class="wip-badge">WIP</span></a>
        <a href="{{ ('/' ~ lang ~ '/') | url }}tools/#paintingtapestry-in-ruins-lookup">Painting/tapestry lookup <span class="wip-badge">WIP</span></a>
        <a href="{{ ('/' ~ lang ~ '/') | url }}tools/#alloy-ratio-calculator">Alloy ratio calculator <span class="wip-badge">WIP</span></a>
        <a href="{{ ('/' ~ lang ~ '/') | url }}tools/#worldgen-seedbiome-lookup">World seed/biome lookup <span class="wip-badge">WIP</span></a>
        <a href="{{ ('/' ~ lang ~ '/') | url }}tools/">All tools &rarr;</a>
      </div>
    </div>
    <a class="nav-info" href="{{ ('/' ~ lang ~ '/') | url }}info/">Info</a>
  </header>
  <main class="content">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>
      Generated
      <a href="{{ ('/' ~ lang ~ '/') | url }}build/"><time datetime="{{ buildInfo.utcIso }}" data-build-time="{{ buildInfo.utcIso }}">{{ buildInfo.utcIso }}</time></a><span data-build-ago> ago</span>.
      Not affiliated with Anego Studios.
    </p>
  </footer>
</body>
</html>
