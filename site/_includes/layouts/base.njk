<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Vintage Story Wiki" }}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>&#128214;</text></svg>">
  <link rel="stylesheet" href="{{ '/' | url }}assets/style.css">
  <script src="{{ '/' | url }}assets/datatable.js" defer></script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="{{ '/' | url }}">Vintage Story Wiki</a>
    <nav>
      <a href="{{ '/' | url }}items/">Items</a>
      <a href="{{ '/' | url }}recipes/">Recipes</a>
      <a href="{{ '/' | url }}loot/">Loot</a>
      <a href="{{ '/' | url }}structures/">Structures</a>
      <a href="{{ '/' | url }}decor/">Decor &amp; Clothing</a>
      <a href="{{ '/' | url }}lore/">Books &amp; Lore</a>
      <a href="{{ '/' | url }}mods/">Mods</a>
    </nav>
  </header>
  <main class="content">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <p>Generated from Vintage Story game data. Not affiliated with Anego Studios.</p>
  </footer>
</body>
</html>
