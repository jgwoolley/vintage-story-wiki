{#
  Every macro below that builds a link takes `lang` as an explicit first parameter rather than
  referencing the bare global `lang` value -- a macro imported without `with context` (the idiom
  used at every call site) does NOT see the importing template's `lang`, so a bare reference
  silently renders as the literal text "undefined" in the URL (confirmed: this was a real,
  long-standing bug affecting every /items/ and /recipes/ listing page's compact recipe summary,
  e.g. "/undefined/items/betterruins/br-schematic-shipwright/"). Always pass `lang` through from
  the call site, same as the `breadcrumb.njk` macro does.
#}
{% macro ingredientLabel(lang, items, ing) %}
{%- if ing.code -%}
  {%- if "*" in ing.code or "{" in ing.code -%}
    <a href="{{ ('/' ~ lang ~ '/') | url }}items/?q={{ ing.code | wildcardQuery | urlencode }}">{{ ing.code }}</a>
  {%- else -%}
    <a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ ing.domain }}/{{ ing.code | slugify }}/">{{ items | displayName(ing.domain, ing.code) }}</a>
  {%- endif -%}
{%- elif ing.tags and ing.isTool -%}
  <a href="{{ ('/' ~ lang ~ '/') | url }}items/?tag={{ ing.tags[0] | urlencode }}">{{ ing.tags[0] | tagLabel }}</a>
{%- elif ing.tags -%}
  any {% for t in ing.tags %}<a href="{{ ('/' ~ lang ~ '/') | url }}items/?tag={{ t | urlencode }}">{{ t | tagLabel }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
{%- elif ing.validStacks and ing.validStacks.length -%}
  {%- for v in ing.validStacks -%}
    <a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ v.domain }}/{{ v.code | slugify }}/">{{ items | displayName(v.domain, v.code) }}</a>{% if not loop.last %} or {% endif %}
  {%- endfor -%}
{%- endif -%}
{% endmacro %}

{% macro quantity(spec) %}
{%- if spec.minratio != null %} ({{ spec.minratio | percent }}&ndash;{{ spec.maxratio | percent }}){% endif -%}
{%- if spec.quantity and spec.quantity != 1 %} &times;{{ spec.quantity }}{% endif -%}
{%- if spec.litres %} &times;{{ spec.litres }}L{% endif -%}
{% endmacro %}

{% macro outputLabel(lang, items, output, wildcard) %}
{%- if output.code -%}
  {%- if "{" in output.code -%}
    <a href="{{ ('/' ~ lang ~ '/') | url }}items/?q={{ output.code | wildcardQuery | urlencode }}"><code>{{ output.code }}</code></a>
  {%- else -%}
    <a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ output.domain }}/{{ output.code | slugify }}/">{{ items | displayName(output.domain, output.code) }}</a>
  {%- endif -%}
{%- endif -%}
{% endmacro %}

{# Compact one-line "A + B + C -> D" summary of a recipe's ingredients and output. #}
{% macro summary(lang, recipe, items) %}
<div class="recipe-summary">
  {% for ing in recipe.ingredients %}{{ ingredientLabel(lang, items, ing) }}{{ quantity(ing) }}{% if not loop.last %} <span class="plus">+</span> {% endif %}{% endfor %}
  <span class="arrow">&rarr;</span>
  {{ outputLabel(lang, items, recipe.output, recipe.wildcard) }}{{ quantity(recipe.output) }}
</div>
{% endmacro %}
