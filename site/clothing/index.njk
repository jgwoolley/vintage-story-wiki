---
title: Clothing - Vintage Story Wiki
layout: layouts/base.njk
permalink: "{{ lang }}/clothing/index.html"
---
{% import "macros/datatable.njk" as dt %}
<h1>Clothing</h1>
<p class="muted">
  Purely decorative/cosmetic wearable items with no recipe or drop table, so they don't appear
  anywhere else on this wiki &mdash; see the <a href="{{ ('/' ~ lang ~ '/') | url }}info/">Info</a>
  page for why. {{ generated.clothing.length }} catalogued directly from the game's item
  definitions.
</p>

{% call dt.datatable(60, "Search clothing...", ["Name", "Mod"]) %}
{% for item in generated.clothing | sort(false, false, "displayName") %}
  <tr data-search="{{ item.domain }}:{{ item.code }}" data-mod="{{ item.sourceMod }}">
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}clothing/{{ item.domain }}/{{ item.code | slugify }}/">{{ item.displayName }}</a></td>
    <td><span class="tag">{{ item.sourceMod }}</span></td>
  </tr>
{% endfor %}
{% endcall %}
