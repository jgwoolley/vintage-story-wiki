---
title: Recipes - Vintage Story Wiki
layout: layouts/base.njk
---
{% import "macros/datatable.njk" as dt %}
<h1>Recipes</h1>
<p class="muted">{{ generated.recipes.length }} recipes across {{ generated.recipes | groupby("category") | length }} categories.</p>

{% call dt.datatable(60, "Search recipes...", ["Name", "Category", "Mod"]) %}
{% for recipe in generated.recipes | sort(false, false, "name") %}
  <tr data-category="{{ recipe.category }}" data-mod="{{ recipe.sourceMod }}">
    <td><a href="{{ '/' | url }}recipes/{{ recipe.category }}/{{ recipe.id | slugify }}/">{{ recipe.name or recipe.output.code or recipe.id }}</a></td>
    <td><span class="tag">{{ recipe.category }}</span></td>
    <td><span class="tag">{{ recipe.sourceMod }}</span></td>
  </tr>
{% endfor %}
{% endcall %}
