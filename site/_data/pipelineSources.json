[
  {
    "id": "items",
    "title": "Items & Blocks",
    "listingUrl": "items/",
    "modelFiles": ["src/ingest/crossref.ts", "src/ingest/models/loot.ts", "src/ingest/models/deposits.ts", "src/ingest/models/blockpatches.ts", "src/ingest/models/trees.ts", "src/ingest/models/trades.ts", "src/ingest/models/dialogue.ts"],
    "globs": [
      "recipes/**/*.json",
      "itemtypes/**/*.json (only drops/tags/maxstacksize read, not the full definition)",
      "blocktypes/**/*.json (only drops/tags/maxstacksize read, not the full definition)",
      "entities/**/*.json (only death/harvestable drops read)",
      "worldgen/deposits/**/*.json",
      "worldgen/blockpatches/*.json",
      "worldgen/treengenproperties.json",
      "blocktypes/plant/fruittreebranch.json",
      "config/tradelists/*.json",
      "config/dialogue/*.json"
    ]
  },
  {
    "id": "recipes",
    "title": "Recipes",
    "listingUrl": "recipes/",
    "modelFiles": ["src/ingest/models/recipes.ts"],
    "globs": ["recipes/grid/*.json", "recipes/smithing/*.json", "recipes/clayforming/*.json", "recipes/knapping/*.json", "recipes/alloy/*.json", "recipes/barrel/*.json", "recipes/cooking/*.json"]
  },
  {
    "id": "creatures",
    "title": "Creatures",
    "listingUrl": "creatures/",
    "modelFiles": ["src/ingest/models/loot.ts", "src/ingest/models/dialogue.ts"],
    "globs": ["entities/**/*.json", "config/dialogue/*.json"]
  },
  {
    "id": "structures",
    "title": "Structures",
    "listingUrl": "structures/",
    "modelFiles": ["src/ingest/models/structures.ts", "src/ingest/schematicHeader.ts"],
    "globs": ["worldgen/structures.json", "worldgen/villages.json", "worldgen/storystructures.json", "worldgen/hookgeneratedstructures/*.json", "worldgen/schematics/**/*.json (headers/BlockCodes dictionary only, not full voxel data)"]
  },
  {
    "id": "deposits",
    "title": "Deposits",
    "listingUrl": "deposits/",
    "modelFiles": ["src/ingest/models/deposits.ts"],
    "globs": ["worldgen/deposits/**/*.json"]
  },
  {
    "id": "crops",
    "title": "Crops",
    "listingUrl": "crops/",
    "modelFiles": ["src/ingest/models/blockpatches.ts"],
    "globs": ["worldgen/blockpatches/*.json"]
  },
  {
    "id": "trees",
    "title": "Trees",
    "listingUrl": "trees/",
    "modelFiles": ["src/ingest/models/trees.ts"],
    "globs": ["worldgen/treengenproperties.json", "worldgen/treegen/*.json", "blocktypes/plant/*.json (sapling variants only)"]
  },
  {
    "id": "fruit-trees",
    "title": "Fruit Trees",
    "listingUrl": "fruit-trees/",
    "modelFiles": ["src/ingest/models/trees.ts"],
    "globs": ["blocktypes/plant/fruittreebranch.json"]
  },
  {
    "id": "paintings",
    "title": "Paintings",
    "listingUrl": "paintings/",
    "modelFiles": ["src/ingest/models/decor.ts"],
    "globs": ["blocktypes/wood/painting.json"]
  },
  {
    "id": "tapestries",
    "title": "Tapestries",
    "listingUrl": "tapestries/",
    "modelFiles": ["src/ingest/models/decor.ts", "src/ingest/models/tapestryInstances.ts"],
    "globs": ["blocktypes/cloth/tapestry.json", "blocktypes/stone/wallcarving.json", "worldgen/schematics/**/*.json (BlockEntities attribute blobs, decoded)"]
  },
  {
    "id": "clothing",
    "title": "Clothing",
    "listingUrl": "clothing/",
    "modelFiles": ["src/ingest/models/decor.ts"],
    "globs": ["itemtypes/wearable/seraph/*.json"]
  },
  {
    "id": "lore",
    "title": "Books & Lore",
    "listingUrl": "lore/",
    "modelFiles": ["src/ingest/models/lore.ts"],
    "globs": ["config/lore/*.json"]
  },
  {
    "id": "guides",
    "title": "Help Guides",
    "listingUrl": "guides/",
    "modelFiles": ["src/ingest/models/guides.ts"],
    "globs": ["config/handbook/*.json"]
  },
  {
    "id": "trades",
    "title": "Trades",
    "listingUrl": "trades/",
    "modelFiles": ["src/ingest/models/trades.ts"],
    "globs": ["config/tradelists/*.json", "entities/humanoid/trader-{male,female}.json (specialization-to-entity join only)"]
  },
  {
    "id": "classes",
    "title": "Classes",
    "listingUrl": "classes/",
    "modelFiles": ["src/ingest/models/classes.ts"],
    "globs": ["config/characterclasses.json", "config/traits.json"]
  },
  {
    "id": "mods",
    "title": "Mods",
    "listingUrl": "mods/",
    "modelFiles": ["src/ingest/modExtractor.ts", "scripts/download.ts"],
    "globs": ["modinfo.json (one per installed mod .zip)", "Mods/<modid>.meta.json (cached mods.vintagestory.at API response, not a game asset)"]
  }
]
