---
pagination:
  data: generated.items
  size: 1
  alias: item
permalink: "items/{{ item.domain }}/{{ item.code | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ item.displayName }} - Vintage Story Wiki"
---
{% import "macros/recipe.njk" as rc %}
<div class="breadcrumb"><a href="/items/">&larr; All items</a></div>

<h1>{{ item.displayName }}</h1>
<p class="muted">
  <span class="tag">{{ item.kind }}</span>
  <code>{{ item.domain }}:{{ item.code }}</code>
  &middot; from <a href="/mods/">{{ item.sourceMod }}</a>
</p>
{% if item.missingTranslation %}<p class="warning">No display name found in any lang file &mdash; showing the raw code.</p>{% endif %}

<h2>Produced by ({{ item.producedBy.length }})</h2>
{% if item.producedBy.length %}
<ul class="recipe-ref-list">
  {% for recipeId in item.producedBy %}
    {% set recipe = generated.recipesById[recipeId] %}
    {% if recipe %}
    <li>
      <a href="/recipes/{{ recipe.category }}/{{ recipe.id | slugify }}/">{{ recipe.name or recipe.category }}</a> <span class="tag">{{ recipe.category }}</span>
      {{ rc.summary(recipe | contextualRecipe(item.domain, item.code), generated.items) }}
    </li>
    {% endif %}
  {% endfor %}
</ul>
{% else %}<p class="muted">No known recipe produces this.</p>{% endif %}

<h2>Used in ({{ item.consumedBy.length }})</h2>
{% if item.consumedBy.length %}
<ul class="recipe-ref-list">
  {% for recipeId in item.consumedBy %}
    {% set recipe = generated.recipesById[recipeId] %}
    {% if recipe %}
    <li>
      <a href="/recipes/{{ recipe.category }}/{{ recipe.id | slugify }}/">{{ recipe.name or recipe.category }}</a> <span class="tag">{{ recipe.category }}</span>
      {{ rc.summary(recipe | contextualRecipe(item.domain, item.code), generated.items) }}
    </li>
    {% endif %}
  {% endfor %}
</ul>
{% else %}<p class="muted">Not used as an ingredient in any known recipe.</p>{% endif %}

<h2>Dropped by ({{ item.droppedBy.length }})</h2>
{% if item.droppedBy.length %}
<table>
  <thead><tr><th>Source</th><th>Mechanism</th><th>Chance / Quantity</th></tr></thead>
  <tbody>
  {% for lootIdx in item.droppedBy %}
    {% set loot = generated.loot[lootIdx] %}
    {% if loot %}
    <tr>
      <td><a href="/loot/{{ loot.sourceDomain }}/{{ loot.sourceCode | slugify }}/">{{ loot.sourceDisplayName }}</a> <span class="tag">{{ loot.sourceKind }}</span></td>
      <td>{{ loot.mechanism }}</td>
      <td>
        {% if loot.drop.chanceAvg != null %}{{ loot.drop.chanceAvg | percent }}{% endif %}
        {% if loot.drop.quantityAvg != null %}&times;{{ loot.drop.quantityAvg | round(2) }}{% endif %}
      </td>
    </tr>
    {% endif %}
  {% endfor %}
  </tbody>
</table>
{% else %}<p class="muted">Not a known drop from any block or entity.</p>{% endif %}
