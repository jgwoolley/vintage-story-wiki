{
  "name": "@nf3t/vintage-story-wiki",
  "version": "0.1.0",
  "private": true,
  "author": "Nf3t (https://github.com/jgwoolley)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgwoolley/vintage-story-wiki.git"
  },
  "homepage": "https://github.com/jgwoolley/vintage-story-wiki#readme",
  "bugs": {
    "url": "https://github.com/jgwoolley/vintage-story-wiki/issues"
  },
  "keywords": [
    "vintage-story",
    "wiki"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "download": "tsx apps/vs-wiki/scripts/download.ts",
    "ingest": "tsx apps/vs-wiki/src/ingest/index.ts",
    "build": "npm run build:libs && npm run ingest && tsx apps/vs-wiki/scripts/build-site.ts",
    "rebuild": "npm run build:libs && tsx apps/vs-wiki/scripts/build-site.ts",
    "serve": "npm run build:libs && npm run ingest && eleventy --serve --config=apps/vs-wiki/eleventy.config.js",
    "clean": "rm -rf .scratch _site libs/*/dist apps/vs-wiki/site/_data/generated",
    "typecheck": "tsc --noEmit && tsc --noEmit -p libs/vs-schematic/tsconfig.json && npm run typecheck -w vs-vscode-extension && npm run typecheck -w @nf3t/vsdev",
    "test": "tsx --test libs/*/test/*.test.ts apps/*/test/*.test.ts",
    "check-links": "tsx apps/vs-wiki/scripts/check-links.ts",
    "decode-stats": "tsx apps/vs-wiki/scripts/decode-stats.ts",
    "build:libs": "npm run build -w @nf3t/vs-schematic",
    "build:extension": "npm run package -w vs-vscode-extension"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "libs/*",
    "apps/*"
  ]
}
