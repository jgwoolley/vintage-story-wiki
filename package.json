{
  "name": "vintage-story-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "download": "./download.sh $(node scripts/manifest-to-args.js)",
    "ingest": "tsx src/ingest/index.ts",
    "build": "npm run ingest && eleventy",
    "serve": "npm run ingest && eleventy --serve",
    "clean": "rm -rf .scratch _site site/_data/generated",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "adm-zip": "^0.5.16",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
