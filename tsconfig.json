{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "noEmit": true
  },
  "include": [
    "libs/vs-wiki-core/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/scripts/**/*.ts",
    "apps/*/test/**/*.ts"
  ],
  "exclude": [
    "apps/vs-vscode-extension"
  ]
}
