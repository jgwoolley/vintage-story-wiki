---
title: Structures - Vintage Story Wiki
layout: layouts/base.njk
permalink: "{{ lang }}/structures/index.html"
---
{% import "macros/datatable.njk" as dt %}
{% import "macros/breadcrumb.njk" as bc %}
{{ bc.trail(lang, [{label: "Structures"}]) }}
<h1>Generated Structures</h1>
<p class="muted">{{ generated.structures.length }} structure/village/story-structure definitions.</p>
<p class="muted">Source: <code>worldgen/structures.json</code>, <code>worldgen/villages.json</code>, <code>worldgen/storystructures.json</code>, and hook-generated structures. <a href="{{ ('/' ~ lang ~ '/') | url }}sources/structures/">Full details &rarr;</a></p>

{% call dt.datatable(60, "Search structures...", ["Name", "Kind", "Mod"]) %}
{% for structure in generated.structures | sort(false, false, "code") %}
  <tr data-category="{{ structure.kind }}" data-mod="{{ structure.sourceMod }}" data-mod-label="{{ generated.mods | modName(structure.sourceMod) }}">
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}structures/{{ structure.id | slugify }}/">{{ structure.name or structure.code }}</a></td>
    <td><span class="tag">{{ structure.kind }}</span></td>
    <td><span class="tag">{{ structure.sourceMod }}</span></td>
  </tr>
{% endfor %}
{% endcall %}
