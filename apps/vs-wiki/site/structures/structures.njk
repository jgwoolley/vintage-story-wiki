---
pagination:
  data: generated.structures
  size: 1
  alias: structure
permalink: "{{ lang }}/structures/{{ structure.id | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ structure.name or structure.code }} - Vintage Story Wiki"
---
{% import "macros/breadcrumb.njk" as bc %}
{{ bc.trail(lang, [{label: "Structures", url: "structures/"}, {label: structure.name or structure.code}]) }}

<h1>{{ structure.name or structure.code }}</h1>
<p class="muted">
  <span class="tag">{{ structure.kind }}</span>
  {% if structure.group %}<span class="tag">{{ structure.group }}</span>{% endif %}
  <code>{{ structure.domain }}:{{ structure.code }}</code>
  &middot; from <a href="{{ ('/' ~ lang ~ '/') | url }}mods/">{{ structure.sourceMod }}</a>
</p>

<h2>Spawn conditions</h2>
<table>
  <thead><tr><th>Condition</th><th>Value</th><th>What this means</th></tr></thead>
  <tbody>
    {% if structure.chance != null %}<tr><th>Spawn chance</th><td>{% if structure.chance <= 1 %}{{ structure.chance | percent }}{% else %}{{ structure.chance }} (relative weight, not a percentage){% endif %}</td><td>{{ "chance" | restrictionInfo }}</td></tr>{% endif %}
    {% if structure.placement %}<tr><th>Placement</th><td>{{ structure.placement }}</td><td>{{ "placement" | restrictionInfo }}</td></tr>{% endif %}
    {% if structure.minSpawnDistance %}<tr><th>Min spawn distance</th><td>{{ structure.minSpawnDistance }} blocks</td><td>{{ "minSpawnDistance" | restrictionInfo }}</td></tr>{% endif %}
    {% if structure.minGroupDistance %}<tr><th>Min distance between instances</th><td>{{ structure.minGroupDistance }} blocks</td><td>{{ "minGroupDistance" | restrictionInfo }}</td></tr>{% endif %}
    {% for key, value in structure.restrictions %}
      <tr><th>{{ key | restrictionLabel }}</th><td>{{ value }}</td><td>{{ (key | restrictionInfo) or "" }}</td></tr>
    {% endfor %}
  </tbody>
</table>

<h2>Schematics</h2>
<p class="muted">The block layouts this structure can place. Each links to its own <a href="{{ ('/' ~ lang ~ '/') | url }}schematics/">schematic page</a> and can be opened in the 3D viewer.</p>
{% for ref in structure.schematics %}
  <div class="card">
    <p class="muted">{{ ref.globPath }}{% if ref.weight %} &middot; weight {{ ref.weight }}{% endif %}{% if ref.minQuantity != null or ref.maxQuantity != null %} &middot; quantity {{ ref.minQuantity }}{% if ref.maxQuantity != ref.minQuantity %}&ndash;{{ ref.maxQuantity }}{% endif %}{% endif %}</p>
    {% if ref.schematicIds.length %}
    <table>
      <thead><tr><th>Schematic</th><th>Size (X&times;Y&times;Z)</th><th>Distinct block codes</th><th>3D</th></tr></thead>
      <tbody>
      {% for schematicId in ref.schematicIds %}
        {% set schematic = generated.schematics | findById(schematicId) %}
        {% if schematic.id %}
        <tr>
          <td><a href="{{ ('/' ~ lang ~ '/') | url }}schematics/{{ schematic.pagePath }}/">{{ schematic.relPath }}</a></td>
          <td>{{ schematic.sizeX }}&times;{{ schematic.sizeY }}&times;{{ schematic.sizeZ }}</td>
          <td>{{ schematic.blockCodeCount }}</td>
          <td><a href="{{ ('/' ~ lang ~ '/') | url }}schematics/viewer/?schematic={{ (schematic.domain ~ '/' ~ schematic.relPath) | urlencode }}">View</a></td>
        </tr>
        {% endif %}
      {% endfor %}
      </tbody>
    </table>
    {% else %}<p class="muted">No matching schematic files found.</p>{% endif %}
  </div>
{% endfor %}
