---
description: A statically-generated wiki of Vintage Story crafting recipes, drop rates, structures, decor/clothing, and in-game books, built directly from the game's own data.
---
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Nf3t's Vintage Story Wiki" }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#4f5d27">
  <link rel="icon" type="image/svg+xml" href="{{ '/' | url }}assets/icon.svg">
  <link rel="apple-touch-icon" href="{{ '/' | url }}assets/apple-touch-icon.png">
  <link rel="manifest" href="{{ '/' | url }}manifest.webmanifest">
  {% if siteUrl %}<link rel="canonical" href="{{ siteUrl }}{{ page.url | url }}">{% endif %}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Nf3t's Vintage Story Wiki">
  <meta property="og:title" content="{{ title or 'Vintage Story Wiki' }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ siteUrl }}{{ '/' | url }}assets/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Nf3t's Vintage Story Wiki: recipes, drops, structures, decor and lore generated from the game's own data">
  <meta property="og:locale" content="{{ lang }}">
  {% if siteUrl %}<meta property="og:url" content="{{ siteUrl }}{{ page.url | url }}">{% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or 'Vintage Story Wiki' }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ siteUrl }}{{ '/' | url }}assets/og-image.png">
  <meta name="twitter:image:alt" content="Nf3t's Vintage Story Wiki: recipes, drops, structures, decor and lore generated from the game's own data">
  {% if siteUrl and page.url == ('/' ~ lang ~ '/') | url %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"Nf3t's Vintage Story Wiki","url":"{{ siteUrl }}{{ page.url | url }}","description":"{{ description }}","inLanguage":"{{ lang }}"}</script>{% endif %}

  <link rel="stylesheet" href="{{ '/' | url }}assets/style.css?v={{ buildInfo.utcIso }}">
  <script src="{{ '/' | url }}assets/datatable.js?v={{ buildInfo.utcIso }}" defer></script>
  <script src="{{ '/' | url }}assets/build-time.js?v={{ buildInfo.utcIso }}" defer></script>
  <script src="{{ '/' | url }}assets/nav.js?v={{ buildInfo.utcIso }}" defer></script>
  <script src="{{ '/' | url }}assets/wikiSearch.js?v={{ buildInfo.utcIso }}" defer></script>
  <script src="{{ '/' | url }}assets/toc.js?v={{ buildInfo.utcIso }}" defer></script>
  <script src="{{ '/' | url }}assets/dropzone.js?v={{ buildInfo.utcIso }}" defer></script>
  <script src="{{ '/' | url }}assets/layers.js?v={{ buildInfo.utcIso }}" defer></script>
  {#- Bare-specifier mapping for the vendored Three.js (see apps/vs-wiki/eleventy.config.js passthrough). Costs
      nothing on pages that never import it; must precede any <script type="module">. -#}
  <script type="importmap">
    {"imports": {
      "three": "{{ '/' | url }}assets/vendor/three/three.module.min.js",
      "three/addons/": "{{ '/' | url }}assets/vendor/three/addons/"
    }}
  </script>
</head>
<body>
  <header class="site-header">
    <button type="button" class="wiki-menu-toggle" id="wikiMenuToggle" aria-controls="wikiSidebar" aria-expanded="false" aria-label="Menu">&#9776;</button>
    <a class="brand" href="{{ ('/' ~ lang ~ '/') | url }}"><img src="{{ '/' | url }}assets/icon.svg" alt="" class="app-icon"><span class="brand-text">Vintage Story <span class="brand-sub">Wiki</span></span></a>
    <form class="wiki-search" role="search" id="wikiSearchForm" action="{{ ('/' ~ lang ~ '/') | url }}items/" data-base="{{ ('/' ~ lang ~ '/') | url }}" data-index="{{ '/' | url }}assets/searchIndex.json">
      <input type="search" id="wikiSearch" name="q" placeholder="Search items, creatures, structures... (press /)" aria-label="Search the wiki" autocomplete="off" aria-controls="wikiSearchResults">
      <ul class="wiki-search-results" id="wikiSearchResults" role="listbox" hidden></ul>
    </form>
  </header>
  <div class="wiki-body">
    <aside class="wiki-sidebar" id="wikiSidebar">
      <nav class="wiki-panel" aria-label="Navigation">
        <h2>Navigation</h2>
        <ul>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}">Main page</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}items/">Items &amp; Blocks</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}recipes/">Recipes</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}creatures/">Creatures</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}map/">Map &amp; waypoints</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}sources/">Where the data comes from</a></li>
        </ul>
      </nav>
      <nav class="wiki-panel" aria-label="Crafting">
        <h2>Crafting</h2>
        <ul>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}recipes/alloy-calculator/">Alloy calculator</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}weapons/">Weapons &amp; Tools</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}armor/">Armor</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}foods/">Foods</a></li>
        </ul>
      </nav>
      <nav class="wiki-panel" aria-label="World">
        <h2>World</h2>
        <ul>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}structures/">Structures</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}schematics/">Schematics</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}schematics/viewer/">Schematic viewer</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}schematics/search/">Schematic block/item search</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}schematics/chisel-shape/">Chiseled shape viewer</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}deposits/">Deposits</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}crops/">Crops</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}trees/">Trees</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}fruit-trees/">Fruit trees</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}calendar/">Calendar</a></li>
        </ul>
      </nav>
      <nav class="wiki-panel" aria-label="Decor &amp; Lore">
        <h2>Decor &amp; Lore</h2>
        <ul>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}paintings/">Paintings</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}tapestries/">Tapestries</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}clutter/">Clutter</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}clothing/">Clothing</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}books/">Books</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}lore/">Lore</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}guides/">Guides</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}traders/">Traders</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}trades/">Trades price guide</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}classes/">Classes</a></li>
        </ul>
      </nav>
      <nav class="wiki-panel" aria-label="About">
        <h2>About</h2>
        <ul>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}info/">About this wiki</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}mods/">Mods</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}extension/">VS Code extension</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}settings/">Settings</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}research/">Research</a></li>
          <li><a href="{{ ('/' ~ lang ~ '/') | url }}build/">Build information</a></li>
          <li><a href="https://www.nf3t.com" target="_blank" rel="noopener noreferrer">NF3t tools</a></li>
          <li><a href="https://www.nf3t.com/#/aistance" target="_blank" rel="noopener noreferrer">Stance on AI</a></li>
          <li><a href="https://github.com/jgwoolley/vintage-story-wiki" target="_blank" rel="noopener noreferrer">Source code</a></li>
        </ul>
      </nav>
    </aside>
    <main class="content">
      {{ content | safe }}
    </main>
  </div>
  <footer class="site-footer">
    <p>
      Generated
      <a href="{{ ('/' ~ lang ~ '/') | url }}build/"><time datetime="{{ buildInfo.utcIso }}" data-build-time="{{ buildInfo.utcIso }}">{{ buildInfo.utcIso }}</time></a><span data-build-ago> ago</span>.
      Not affiliated with Anego Studios.
    </p>
  </footer>
</body>
</html>
