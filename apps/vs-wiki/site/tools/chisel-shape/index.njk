{% import "macros/breadcrumb.njk" as bc %}
{{ bc.trail(lang, [{label: "Tools", url: "tools/"}, {label: "Chiseled shape viewer"}]) }}
<h1>Chiseled shape viewer</h1>
<p class="muted">
  Upload a shape file saved by QPTech's <a href="https://mods.vintagestory.at/chiseltools">ChiselTools</a> mod
  (<code>.pf save &lt;name&gt;</code> writes it to the <code>chiselportfolio</code> folder inside your
  <code>VintagestoryData</code> folder) to see the chiseled block in 3D, what it is made of, and to find the same shape
  in the game's own schematics. Everything is decoded in your browser; nothing is uploaded anywhere.
</p>

<div id="chiselShape" data-block-colors="{{ '/' | url }}assets/Nf3tBlockColors.json" data-block-names="{{ '/' | url }}assets/blockNames.json" data-items-url="{{ ('/' ~ lang ~ '/') | url }}items/" data-search-url="{{ ('/' ~ lang ~ '/') | url }}tools/schematic-search/">
  <label class="schematic-dropzone" for="csFile">
    <strong>Upload a ChiselTools shape file</strong>
    <span class="muted">Drop a file from your <code>chiselportfolio</code> folder here, or click to browse</span>
    <input type="file" id="csFile" hidden>
  </label>
  <p id="csError" class="schematic-error" role="alert" hidden></p>
  <div id="csResult" hidden>
    <h2 id="csName"></h2>
    <div class="schematic-row-fields">
      <div id="csPreview" class="chisel-preview"></div>
      <div>
        <button type="button" id="csReset">Reset view</button>
        <p id="csSummary" class="muted"></p>
        <p id="csFind"></p>
        <div id="csMaterials"></div>
      </div>
    </div>
    <details>
      <summary>Boxes</summary>
      <p class="muted">Each box is a cuboid on the block's 16&times;16&times;16 grid (min inclusive, max exclusive) with an index into the materials list.</p>
      <pre id="csBoxes" class="schematic-json"></pre>
    </details>
  </div>
</div>

<script type="module" src="{{ '/' | url }}assets/chiselShapePage.js"></script>
