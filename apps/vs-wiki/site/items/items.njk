---
pagination:
  data: generated.items
  size: 1
  alias: item
permalink: "{{ lang }}/items/{{ item.domain }}/{{ item.code | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ item.displayName }} - Vintage Story Wiki"
---
{% import "macros/recipe.njk" as rc %}
{% import "macros/datatable.njk" as dt %}
{% import "macros/breadcrumb.njk" as bc %}
{% import "macros/temperature.njk" as tmp %}
{{ bc.trail(lang, [{label: "Items & Blocks", url: "items/"}, {label: item.displayName}]) }}

<h1>{{ item.displayName }}</h1>
<p class="muted">
  <span class="tag">{{ item.kind }}</span>
  <code>{{ item.domain }}:{{ item.code }}</code>
  &middot; from <a href="{{ ('/' ~ lang ~ '/') | url }}mods/">{{ item.sourceMod }}</a>
</p>
{% if item.missingTranslation %}<p class="warning">No display name found in any lang file &mdash; showing the raw code.</p>{% endif %}
{% if item.includedByManifest %}<p class="muted">Listed explicitly in the wiki's <code>vs-manifest.json</code> (<code>includeItems</code>: <code>{{ item.includedByManifest }}</code>), so it has a page even if nothing else here links to it.</p>{% endif %}
{% if item.description %}<div class="card">{{ item.description | safe }}</div>{% endif %}
{% set blockDrops = generated.blockDropsById[item.domain ~ ':' ~ item.code] %}

{% set itemTags = item.tags | default([]) %}
{% if itemTags.length or item.maxStackSize != null %}
<table>
  <tbody>
    {% if item.maxStackSize != null %}<tr><th>Stack size</th><td>{{ item.maxStackSize }}</td></tr>{% endif %}
    {% if itemTags.length %}
    <tr>
      <th>Tags</th>
      <td>{% for t in itemTags %}<a class="tag" href="{{ ('/' ~ lang ~ '/') | url }}items/?tag={{ t | urlencode }}">{{ t }}</a>{% endfor %}</td>
    </tr>
    {% endif %}
  </tbody>
</table>
{% endif %}

{% if item.codeRefs %}
{#- C# names this item/block's own JSON points at, linked to the implementing file via the
    committed apps/vs-wiki/src/ingest/csharpClassMap.json (see apps/vs-wiki/scripts/map-csharp-classes.ts). -#}
{% set codeRoleLabels = {
  "class": ("Block class" if item.kind == "block" else "Item class"),
  "entityClass": "Block entity",
  "behavior": "Behavior",
  "entityBehavior": "Block entity behavior"
} %}
<h2>Game logic (C#)</h2>
<p class="muted">The C# classes this {{ item.kind }}'s JSON definition hands its behavior to. Files link to <a href="https://github.com/anegostudios/vssurvivalmod">vssurvivalmod</a> on GitHub, pinned to the commit the mapping was made from.</p>
<table>
  <thead><tr><th>Role</th><th>Name in JSON</th><th>C# type</th><th>Source file</th></tr></thead>
  <tbody>
  {% for ref in item.codeRefs %}
    <tr>
      <td>{{ codeRoleLabels[ref.role] }}</td>
      <td><code>{{ ref.name }}</code></td>
      <td>{% if ref.type %}<code>{{ ref.type }}</code>{% endif %}</td>
      <td>{% if ref.url %}<a href="{{ ref.url }}"><code>{{ ref.path }}</code></a>{% else %}<span class="muted">Not in vssurvivalmod (engine, VSEssentials, or a mod DLL)</span>{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if item.rockStrata.length %}
<h2>How this rock forms</h2>
<p class="muted">Rock *type* placement is a separate worldgen system from ore/gem deposits -- see the full <a href="{{ ('/' ~ lang ~ '/') | url }}deposits/">Deposits</a> page for how deposits occur inside this rock, once it's present.</p>
<table>
  <thead><tr><th>Rock group</th><th>How it is placed</th></tr></thead>
  <tbody>
  {% for rsId in item.rockStrata %}
    {% set rs = generated.rockStrataById[rsId] %}
    {% if rs.id %}
    <tr>
      <td>{% if rs.rockGroup %}<span class="tag">{{ rs.rockGroup }}</span>{% endif %}</td>
      <td>Layered worldgen noise, {% if rs.genDir == "BottomUp" %}anchored near bedrock (fills upward){% elif rs.genDir == "TopDown" %}anchored near the surface (fills downward){% else %}direction unspecified{% endif %}.</td>
    </tr>
    {% endif %}
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if item.spawnDeposits.length %}
<h2>Where to find (natural deposits)</h2>
<p class="muted">Read directly from the game's worldgen rules -- see <a href="{{ ('/' ~ lang ~ '/') | url }}info/">Info</a> for how this differs from an exact "X spawns at Y" guarantee. See also the full <a href="{{ ('/' ~ lang ~ '/') | url }}deposits/">Deposits</a> listing.</p>
<table>
  <thead><tr><th>Category</th><th>Occurs in</th><th>Typical depth</th></tr></thead>
  <tbody>
  {% for depId in item.spawnDeposits %}
    {% set dep = generated.depositsById[depId] %}
    {% if dep.id %}
    <tr>
      <td><span class="tag">{{ dep.category }}</span></td>
      <td><strong>{{ dep.hostRocks | join(", ") }}</strong>{% if dep.gradesByRock %} <span class="muted">(grade varies by rock type -- richer grades are rarer)</span>{% endif %}</td>
      <td>{% if dep.yPosRel %}{% set y = dep.yPosRel.avg %}{% if y >= 0.8 %}near the surface{% elif y >= 0.5 %}shallow underground{% elif y >= 0.25 %}moderate depth{% else %}deep underground{% endif %} <span class="muted">(relative height {{ y | round(2) }} -- {{ "yPosRel" | restrictionInfo }})</span>{% endif %}</td>
    </tr>
    {% endif %}
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if item.spawnBlockPatches.length %}
<h2>Where to find (natural growth)</h2>
<p class="muted">Climate conditions a chunk needs for this to grow wild (temperature shaded blue = cold, red = hot). See also the full <a href="{{ ('/' ~ lang ~ '/') | url }}crops/">Crops</a> listing.</p>
{% call dt.datatable(20, "Search growth conditions...", ["Category", "Temp (&deg;C)", "Rain", "Forest density", "Soil fertility", "Placement", "Crop"]) %}
{% for patchId in item.spawnBlockPatches %}
  {% set patch = generated.blockPatchesById[patchId] %}
  {% if patch.id %}
  <tr data-category="{{ patch.category }}" data-search="{{ patch.category }} {{ patch.placement }}">
    <td><span class="tag">{{ patch.category }}</span></td>
    <td>{{ tmp.range(patch.minTemp, patch.maxTemp) }}</td>
    <td>{% if patch.minRain != null or patch.maxRain != null %}{{ patch.minRain if patch.minRain != null else 0 }}&ndash;{{ patch.maxRain if patch.maxRain != null else 1 }}{% endif %}</td>
    <td>{% if patch.minForest != null or patch.maxForest != null %}{{ patch.minForest if patch.minForest != null else 0 }}&ndash;{{ patch.maxForest if patch.maxForest != null else 1 }}{% endif %}</td>
    <td>{% if patch.minFertility != null or patch.maxFertility != null %}{{ patch.minFertility if patch.minFertility != null else 0 }}&ndash;{{ patch.maxFertility if patch.maxFertility != null else 1 }}{% endif %}</td>
    <td>{{ patch.placement }}</td>
    <td>{% if patch.crop.requiredNutrient %}draws <strong>{{ {N: 'nitrogen', P: 'phosphorus', K: 'potassium'}[patch.crop.requiredNutrient] or patch.crop.requiredNutrient }}</strong> ({{ patch.crop.requiredNutrient }}){% if patch.crop.nutrientConsumption != null %}, uses {{ patch.crop.nutrientConsumption }} per cycle{% endif %}{% if patch.crop.totalGrowthMonths != null %}, grows in {{ patch.crop.totalGrowthMonths }} months{% endif %}{% endif %}</td>
  </tr>
  {% endif %}
{% endfor %}
{% endcall %}
{% endif %}

{% if item.spawnTrees.length %}
<h2>Where to find (tree growth)</h2>
<p class="muted">Climate band this tree species can generate in. See also the full <a href="{{ ('/' ~ lang ~ '/') | url }}trees/">Trees</a> listing.</p>
<table>
  <thead><tr><th>Type</th><th>Species</th><th>Temp (&deg;C)</th><th>Rain</th><th>Forest density</th><th>Soil fertility</th><th>Habitat</th></tr></thead>
  <tbody>
  {% for treeId in item.spawnTrees %}
    {% set tree = generated.treesById[treeId] %}
    {% if tree.id %}
    <tr>
      <td><span class="tag">{{ "shrub" if tree.isShrub else "tree" }}</span></td>
      <td>{% if tree.saplingCodes and tree.saplingCodes.length %}{{ generated.items | displayName(tree.domain, tree.saplingCodes[0]) }}{% else %}{{ tree.generator }}{% endif %}</td>
      <td>{{ tmp.range(tree.minTemp, tree.maxTemp) }}</td>
      <td>{% if tree.minRain != null or tree.maxRain != null %}{{ (tree.minRain if tree.minRain != null else 0) | round(2) }}&ndash;{{ (tree.maxRain if tree.maxRain != null else 1) | round(2) }}{% endif %}</td>
      <td>{% if tree.minForest != null or tree.maxForest != null %}{{ (tree.minForest if tree.minForest != null else 0) | round(2) }}&ndash;{{ (tree.maxForest if tree.maxForest != null else 1) | round(2) }}{% endif %}</td>
      <td>{% if tree.minFertility != null or tree.maxFertility != null %}{{ (tree.minFertility if tree.minFertility != null else 0) | round(2) }}&ndash;{{ (tree.maxFertility if tree.maxFertility != null else 1) | round(2) }}{% endif %}</td>
      <td>{{ tree.habitat }}</td>
    </tr>
    {% endif %}
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if item.spawnFruitTrees.length %}
<h2>Where to find (fruit tree growth)</h2>
<p class="muted">See also the full <a href="{{ ('/' ~ lang ~ '/') | url }}fruit-trees/">Fruit Trees</a> listing.</p>
<table>
  <thead><tr><th>Variety</th><th>Temp (&deg;C)</th><th>Rain</th></tr></thead>
  <tbody>
  {% for ftId in item.spawnFruitTrees %}
    {% set ft = generated.fruitTreesById[ftId] %}
    {% if ft.id %}
    <tr>
      <td>{% if ft.fruitItemCode %}{{ generated.items | displayName(ft.domain, ft.fruitItemCode) }}{% else %}{{ ft.variety }}{% endif %}</td>
      <td>{{ tmp.range(ft.minTemp, ft.maxTemp) }}</td>
      <td>{% if ft.minRain != null or ft.maxRain != null %}{{ ft.minRain }}&ndash;{{ ft.maxRain }}{% endif %}</td>
    </tr>
    {% endif %}
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if blockDrops.id %}
<h2>Drops ({{ blockDrops.entries.length }})</h2>
{% call dt.datatable(20, "Search drops...", ["Mechanism", "Drop", "Chance / Quantity", "Notes"]) %}
{% for entry in blockDrops.entries %}
  <tr data-category="{{ entry.mechanism }}">
    <td>{{ entry.mechanism }}{% if entry.panningKeyPattern %}<br><span class="muted tag">{{ entry.panningKeyPattern }}</span>{% endif %}</td>
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ entry.drop.domain }}/{{ entry.drop.code | slugify }}/">{{ generated.items | displayName(entry.drop.domain, entry.drop.code) }}</a></td>
    <td>
      {% if entry.drop.chanceAvg != null %}{{ entry.drop.chanceAvg | percent }}{% endif %}
      {% if entry.drop.quantityAvg != null %}&times;{{ entry.drop.quantityAvg | round(2) }}{% if entry.drop.quantityVar %} (&plusmn;{{ entry.drop.quantityVar }}){% endif %}{% endif %}
    </td>
    <td>
      {% if entry.drop.manMade %}<span class="tag">man-made</span>{% endif %}
      {% if entry.drop.dropModbyStat %}<span class="tag">scales with {{ entry.drop.dropModbyStat }}</span>{% endif %}
      {% if entry.stackRandomizerCode %}
        {% set containerParts = entry.stackRandomizerCode.split(':') %}
        <span class="tag">from <a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ containerParts[0] }}/{{ containerParts[1] | slugify }}/">{{ generated.items | displayName(containerParts[0], containerParts[1]) }}</a></span>
      {% endif %}
    </td>
  </tr>
{% endfor %}
{% endcall %}
{% endif %}

{% if item.producedBy.length %}
<h2>Produced by ({{ item.producedBy.length }})</h2>
{% call dt.datatable(20, "Search recipes...", ["Recipe", "Category", "Ingredients → output"]) %}
{% for recipeId in item.producedBy %}
  {% set recipe = generated.recipesById[recipeId] %}
  {% if recipe %}
  <tr data-category="{{ recipe.category }}">
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}recipes/{{ recipe.category }}/{{ recipe.id | slugify }}/">{{ recipe | recipeTitle(generated.items) }}</a></td>
    <td><span class="tag">{{ recipe.category }}</span></td>
    <td>{{ rc.summary(lang, recipe | contextualRecipe(item.domain, item.code), generated.items) }}</td>
  </tr>
  {% endif %}
{% endfor %}
{% endcall %}
{% endif %}

{% if item.consumedBy.length %}
<h2>Used in ({{ item.consumedBy.length }})</h2>
{% call dt.datatable(20, "Search recipes...", ["Recipe", "Category", "Ingredients → output"]) %}
{% for recipeId in item.consumedBy %}
  {% set recipe = generated.recipesById[recipeId] %}
  {% if recipe %}
  <tr data-category="{{ recipe.category }}">
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}recipes/{{ recipe.category }}/{{ recipe.id | slugify }}/">{{ recipe | recipeTitle(generated.items) }}</a></td>
    <td><span class="tag">{{ recipe.category }}</span></td>
    <td>{{ rc.summary(lang, recipe | contextualRecipe(item.domain, item.code), generated.items) }}</td>
  </tr>
  {% endif %}
{% endfor %}
{% endcall %}
{% endif %}

{% if item.droppedBy.length %}
<h2>Dropped by ({{ item.droppedBy.length }})</h2>
{% call dt.datatable(20, "Search sources...", ["Source", "Kind", "Mechanism", "Chance / Quantity"]) %}
{% for lootIdx in item.droppedBy %}
  {% set loot = generated.loot[lootIdx] %}
  {% if loot %}
  <tr data-category="{{ loot.sourceKind }}">
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}{{ 'creatures' if loot.sourceKind == 'entity' else 'items' }}/{{ loot.sourceDomain }}/{{ loot.sourceCode | slugify }}/">{{ loot.sourceDisplayName }}</a></td>
    <td><span class="tag">{{ loot.sourceKind }}</span></td>
    <td>
      {{ loot.mechanism }}
      {% if loot.stackRandomizerCode %}
        {% set containerParts = loot.stackRandomizerCode.split(':') %}
        <br><span class="muted tag">from <a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ containerParts[0] }}/{{ containerParts[1] | slugify }}/">{{ generated.items | displayName(containerParts[0], containerParts[1]) }}</a></span>
      {% endif %}
    </td>
    <td>
      {% if loot.drop.chanceAvg != null %}{{ loot.drop.chanceAvg | percent }}{% endif %}
      {% if loot.drop.quantityAvg != null %}&times;{{ loot.drop.quantityAvg | round(2) }}{% endif %}
    </td>
  </tr>
  {% endif %}
{% endfor %}
{% endcall %}
{% endif %}

{% if item.randomPool.length %}
<h2>Can generate ({{ item.randomPool.length }})</h2>
<p class="muted">
  This is a random-stack placeholder: when the game generates the chest, vessel or drop it sits in, it
  swaps this item for <strong>one</strong> of the results below, picked by the relative chance shown.
  A placed randomizer can also carry its own overall chance of generating nothing at all, which is
  per-instance data and not part of this definition.
</p>
{% call dt.datatable(25, "Search results...", ["Result", "Kind", "Chance", "Quantity"]) %}
{% for stack in item.randomPool %}
  <tr data-search="{{ stack.code }} {{ stack.attributes.type }}" data-category="{{ stack.kind }}">
    <td>
      <a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ stack.domain }}/{{ stack.code | slugify }}/">{{ generated.items | displayName(stack.domain, stack.code) }}</a>
      {% if stack.attributes.type %}<br><span class="muted tag">type: <a href="{{ ('/' ~ lang ~ '/') | url }}clutter/?q={{ stack.attributes.type | urlencode }}">{{ stack.attributes.type }}</a></span>{% endif %}
    </td>
    <td><span class="tag">{{ stack.kind }}</span></td>
    <td>{{ stack.chance | percent }}</td>
    <td>{% if stack.quantityVar %}{{ (stack.quantityAvg - stack.quantityVar) | round(2) }}&ndash;{{ (stack.quantityAvg + stack.quantityVar) | round(2) }}{% elif stack.quantityAvg != null %}{{ stack.quantityAvg | round(2) }}{% else %}1{% endif %}</td>
  </tr>
{% endfor %}
{% endcall %}
{% endif %}

{% if item.generatedBy.length %}
<h2>Can be generated by ({{ item.generatedBy.length }})</h2>
<p class="muted">Random-stack placeholders (placed in world-generated chests and similar) whose pool includes this. The chance is among that placeholder's results, not the chance of finding it.</p>
<table>
  <thead><tr><th>Placeholder</th><th>Chance</th></tr></thead>
  <tbody>
{% for src in item.generatedBy %}
  <tr>
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ src.domain }}/{{ src.code | slugify }}/">{{ generated.items | displayName(src.domain, src.code) }}</a></td>
    <td>{{ src.chance | percent }}</td>
  </tr>
{% endfor %}
  </tbody>
</table>
{% endif %}

{% if item.tradesSelling.length %}
<h2>Sold by traders ({{ item.tradesSelling.length }})</h2>
{% call dt.datatable(20, "Search traders...", ["Trader", "Price min (per stack)", "Price max (per stack)", "Stock min (stacks)", "Stock max (stacks)", "Items per stack"]) %}
{% for listingId in item.tradesSelling %}
  {% set listing = generated.tradeListingsById[listingId] %}
  {% if listing.id %}
  <tr>
    {% set trader = generated.trades | findById(listing.tradeListId) %}
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}traders/{{ listing.tradeListId | slugify }}/">{{ trader.displayName or listing.tradeListId.split(':')[1] }}</a></td>
    <td>{% if listing.priceMin != null %}{{ listing.priceMin | round(2) }}{% endif %}</td>
    <td>{% if listing.priceMax != null %}{{ listing.priceMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMin != null %}{{ listing.stockMin | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMax != null %}{{ listing.stockMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stacksize %}{{ listing.stacksize }}{% endif %}</td>
  </tr>
  {% endif %}
{% endfor %}
{% endcall %}
{% endif %}

{% if item.tradesBuying.length %}
<h2>Bought by traders ({{ item.tradesBuying.length }})</h2>
{% call dt.datatable(20, "Search traders...", ["Trader", "Price min (per stack)", "Price max (per stack)", "Stock min (stacks)", "Stock max (stacks)", "Items per stack"]) %}
{% for listingId in item.tradesBuying %}
  {% set listing = generated.tradeListingsById[listingId] %}
  {% if listing.id %}
  <tr>
    {% set trader = generated.trades | findById(listing.tradeListId) %}
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}traders/{{ listing.tradeListId | slugify }}/">{{ trader.displayName or listing.tradeListId.split(':')[1] }}</a></td>
    <td>{% if listing.priceMin != null %}{{ listing.priceMin | round(2) }}{% endif %}</td>
    <td>{% if listing.priceMax != null %}{{ listing.priceMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMin != null %}{{ listing.stockMin | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMax != null %}{{ listing.stockMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stacksize %}{{ listing.stacksize }}{% endif %}</td>
  </tr>
  {% endif %}
{% endfor %}
{% endcall %}
{% endif %}

{% if item.npcRewards.length %}
<h2>NPC rewards ({{ item.npcRewards.length }})</h2>
<p class="muted">NPCs whose dialogue can hand this over as a reward (e.g. for completing a small favor, or just for free) -- not something bought at a trade price.</p>
{% call dt.datatable(20, "Search NPCs...", ["NPC", "Stack size"]) %}
{% for rewardIdx in item.npcRewards %}
  {% set reward = generated.dialogueRewards[rewardIdx] %}
  {% if reward.npcId %}
  <tr>
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}creatures/{{ reward.npcDomain }}/{{ reward.npcCode | slugify }}/">{{ reward.npcDisplayName }}</a></td>
    <td>{% if reward.stacksize %}&times;{{ reward.stacksize }}{% endif %}</td>
  </tr>
  {% endif %}
{% endfor %}
{% endcall %}
{% endif %}

{% if item.appearsInStructures.length %}
<h2>Found in structures ({{ item.appearsInStructures.length }})</h2>
<table>
  <thead><tr><th>Structure</th><th>Kind</th></tr></thead>
  <tbody>
{% for structureId in item.appearsInStructures %}
  {% set structure = generated.structures | findById(structureId) %}
  {% if structure.id %}
  <tr>
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}structures/{{ structure.id | slugify }}/">{{ structure.name or structure.code }}</a></td>
    <td><span class="tag">{{ structure.kind }}</span></td>
  </tr>
  {% endif %}
{% endfor %}
  </tbody>
</table>
<p class="muted">This confirms the schematic(s) contain this code somewhere, not where or how many times -- the per-instance block-entity decoding used for tapestries isn't run for every content type.</p>
{% endif %}

<h2>Find in schematics</h2>
<p>
  <a href="{{ ('/' ~ lang ~ '/') | url }}tools/schematic-search/?code={{ item.code | urlencode }}&amp;kind={{ item.kind | urlencode }}">Search every worldgen schematic for this {{ item.kind }} &rarr;</a>
  <span class="muted">Decodes the schematics in your browser to find where it is placed, what chiseled blocks use it, and which chests could hold it (including random placeholders), which the lists above don't cover.</span>
</p>

{% if not item.producedBy.length and not item.consumedBy.length and not item.droppedBy.length and not blockDrops.id and not item.spawnDeposits.length and not item.spawnBlockPatches.length and not item.spawnTrees.length and not item.spawnFruitTrees.length and not item.rockStrata.length and not item.tradesSelling.length and not item.tradesBuying.length and not item.appearsInStructures.length and not item.npcRewards.length and not item.randomPool.length and not item.generatedBy.length %}
<p class="muted">Not produced, consumed, dropped, traded, naturally spawned, found in any structure, or an NPC reward currently catalogued.</p>
{% endif %}
