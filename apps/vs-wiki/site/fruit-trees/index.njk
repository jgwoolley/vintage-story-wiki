---
title: Fruit Trees - Vintage Story Wiki
layout: layouts/base.njk
permalink: "{{ lang }}/fruit-trees/index.html"
---
{% import "macros/itemlink.njk" as il %}
{% import "macros/datatable.njk" as dt %}
{% import "macros/breadcrumb.njk" as bc %}
{% import "macros/temperature.njk" as tmp %}
{{ bc.trail(lang, [{label: "Fruit Trees"}]) }}
<h1>Fruit Trees</h1>
<p class="muted">
  Fruit tree varieties are a distinct worldgen system from regular
  <a href="{{ ('/' ~ lang ~ '/') | url }}trees/">tree species</a> -- a flat temperature/rain band
  per variety, with no forest-density or soil-fertility requirement, read directly from the
  game's worldgen rules.
</p>
<p class="muted">Source: <code>blocktypes/plant/fruittreebranch.json</code>'s <code>attributes.worldgen</code> array. <a href="{{ ('/' ~ lang ~ '/') | url }}sources/fruit-trees/">Full details &rarr;</a></p>

<h2>Fruit varieties ({{ generated.fruitTrees.length }})</h2>
{% call dt.datatable(40, "Search fruit varieties...", ["Fruit", "Temp (°C)", "Rain", "Mod"]) %}
{% for ft in generated.fruitTrees | sort(false, false, "variety") %}
  <tr data-search="{{ ft.variety }} {{ ft.fruitItemCode }}" data-mod="{{ ft.sourceMod }}" data-mod-label="{{ generated.mods | modName(ft.sourceMod) }}">
    <td>{% if ft.fruitItemCode %}{{ il.link(lang, generated.items, ft.domain, ft.fruitItemCode) }}{% else %}{{ ft.variety }}{% endif %}</td>
    <td>{{ tmp.range(ft.minTemp, ft.maxTemp) }}</td>
    <td>{{ ft.minRain }}&ndash;{{ ft.maxRain }}</td>
    <td><span class="tag">{{ ft.sourceMod }}</span></td>
  </tr>
{% endfor %}
{% endcall %}
