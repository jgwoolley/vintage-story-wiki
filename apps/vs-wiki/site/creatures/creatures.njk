---
pagination:
  data: generated.creatures
  size: 1
  alias: source
permalink: "{{ lang }}/creatures/{{ source.sourceDomain }}/{{ source.sourceCode | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ source.sourceDisplayName }} - Vintage Story Wiki"
---
{% import "macros/datatable.njk" as dt %}
{% import "macros/breadcrumb.njk" as bc %}
{% import "macros/temperature.njk" as tmp %}
{% import "macros/model.njk" as mdl %}
{{ bc.trail(lang, [{label: "Creatures", url: "creatures/"}, {label: source.sourceDisplayName}]) }}

<h1>{{ source.sourceDisplayName }}</h1>
<p class="muted">
  <code>{{ source.sourceDomain }}:{{ source.sourceCode }}</code>
  &middot; from <a href="{{ ('/' ~ lang ~ '/') | url }}mods/">{{ source.sourceMod }}</a>
</p>

{% if source.model.path %}{{ mdl.preview(source.model, source.sourceDisplayName) }}{% endif %}

{% if source.entityStats %}
<h2>Stats</h2>
<table>
  <tbody>
    {% if source.entityStats.maxHealth != null %}<tr><th>Max health</th><td>{{ source.entityStats.maxHealth }} hp</td></tr>{% endif %}
    {% if source.entityStats.damageTier != null %}<tr><th>Tier</th><td>{{ source.entityStats.damageTier }} <span class="muted">(attack damage tier -- compared against armor's protection tier; higher hits through more armor)</span></td></tr>{% endif %}
    {% if source.entityStats.weight != null %}<tr><th>Weight</th><td>{{ source.entityStats.weight }} kg</td></tr>{% endif %}
    {% if source.entityStats.sizeX != null %}<tr><th>Hitbox size</th><td>{{ source.entityStats.sizeX }} &times; {{ source.entityStats.sizeY }} (width &times; height, blocks)</td></tr>{% endif %}
    {% if source.entityStats.tags.length %}
    <tr>
      <th>Tags</th>
      <td>{% for t in source.entityStats.tags %}<a class="tag" href="{{ ('/' ~ lang ~ '/') | url }}creatures/?tag={{ t | urlencode }}">{{ t }}</a>{% endfor %}</td>
    </tr>
    {% endif %}
  </tbody>
</table>
{% endif %}

{% set tradeLists = [] %}
{% for trade in generated.trades %}{% for e in trade.traderEntities %}{% if e.domain == source.sourceDomain and e.code == source.sourceCode %}{% set tradeLists = (tradeLists.push(trade), tradeLists) %}{% endif %}{% endfor %}{% endfor %}
{% if tradeLists.length %}
<h2>Trades</h2>
<ul>
{% for trade in tradeLists %}
  <li><a href="{{ ('/' ~ lang ~ '/') | url }}traders/{{ trade.id | slugify }}/">{{ trade.displayName }}</a> &mdash; sells {{ trade.selling.length }}, buys {{ trade.buying.length }}</li>
{% endfor %}
</ul>
{% endif %}

{% if source.entityStats.codeRefs.length %}
<h2>Game logic (C#)</h2>
<p class="muted">The C# classes this creature's JSON hands its behavior to: its entity class, behaviors and AI tasks. Files link to <a href="https://github.com/anegostudios/vssurvivalmod">vssurvivalmod</a> on GitHub; names without a link are implemented in the game engine or VSEssentials, which aren't mapped here.</p>
<table>
  <thead><tr><th>Role</th><th>Name in JSON</th><th>C# type</th></tr></thead>
  <tbody>
  {% for ref in source.entityStats.codeRefs %}
    <tr>
      <td>{{ {class: "Entity class", entityBehavior: "Behavior", aiTask: "AI task"}[ref.role] }}</td>
      <td><code>{{ ref.name }}</code></td>
      <td>{% if ref.url %}<a href="{{ ref.url }}"><code>{{ ref.type }}</code></a>{% elif ref.type %}<code>{{ ref.type }}</code>{% else %}<span class="muted">engine / VSEssentials</span>{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if source.entityStats.spawn %}
{% set spawn = source.entityStats.spawn %}
<h2>Where it spawns</h2>
<p class="muted">Conditions the game checks at a candidate chunk before this creature can appear there. All of them must hold at once -- it's an AND, not an OR.</p>
<table>
  <thead><tr><th>Condition</th><th>Value</th><th>What this means</th></tr></thead>
  <tbody>
    {% if spawn.minTemp != null or spawn.maxTemp != null %}<tr><th>Temperature</th><td>{{ tmp.range(spawn.minTemp, spawn.maxTemp) }}&deg;C</td><td>{{ "minTemp" | restrictionInfo }}</td></tr>{% endif %}
    {% if spawn.minRain != null or spawn.maxRain != null %}<tr><th>Rain</th><td>{{ spawn.minRain if spawn.minRain != null else 0 }}&ndash;{{ spawn.maxRain if spawn.maxRain != null else 1 }}</td><td>{{ "minRain" | restrictionInfo }}</td></tr>{% endif %}
    {% if spawn.minForest != null or spawn.maxForest != null %}<tr><th>Forest density</th><td>{{ spawn.minForest if spawn.minForest != null else 0 }}&ndash;{{ spawn.maxForest if spawn.maxForest != null else 1 }}</td><td>{{ "minForest" | restrictionInfo }}</td></tr>{% endif %}
    {% if spawn.habitatBlocks.length %}
    <tr>
      <th>Needs nearby</th>
      <td>{% for b in spawn.habitatBlocks %}<a href="{{ ('/' ~ lang ~ '/') | url }}items/?q={{ b | wildcardQuery | urlencode }}"><code>{{ b }}</code></a>{% if not loop.last %}, {% endif %}{% endfor %}</td>
      <td>{{ "habitatBlocks" | restrictionInfo }}</td>
    </tr>
    {% endif %}
    {% if spawn.group %}<tr><th>Spawn group</th><td>{{ spawn.group }}</td><td>{{ "group" | restrictionInfo }}</td></tr>{% endif %}
    {% if spawn.chance != null %}<tr><th>Chance</th><td>{{ spawn.chance }} per attempt</td><td>{{ "chance" | restrictionInfo }}</td></tr>{% endif %}
    {% if spawn.triesPerChunk != null %}<tr><th>Tries per chunk</th><td>{{ spawn.triesPerChunk }}</td><td>{{ "triesPerChunk" | restrictionInfo }}</td></tr>{% endif %}
  </tbody>
</table>
{% endif %}

{% if source.entries.length %}
<h2>Drops ({{ source.entries.length }})</h2>
{% call dt.datatable(20, "Search drops...", ["Mechanism", "Drop", "Chance / Quantity", "Notes"]) %}
{% for entry in source.entries %}
  <tr data-category="{{ entry.mechanism }}">
    <td>{{ entry.mechanism }}{% if entry.panningKeyPattern %}<br><span class="muted tag">{{ entry.panningKeyPattern }}</span>{% endif %}</td>
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ entry.drop.domain }}/{{ entry.drop.code | slugify }}/">{{ generated.items | displayName(entry.drop.domain, entry.drop.code) }}</a></td>
    <td>
      {% if entry.drop.chanceAvg != null %}{{ entry.drop.chanceAvg | percent }}{% endif %}
      {% if entry.drop.quantityAvg != null %}&times;{{ entry.drop.quantityAvg | round(2) }}{% if entry.drop.quantityVar %} (&plusmn;{{ entry.drop.quantityVar }}){% endif %}{% endif %}
    </td>
    <td>
      {% if entry.drop.manMade %}<span class="tag">man-made</span>{% endif %}
      {% if entry.drop.dropModbyStat %}<span class="tag">scales with {{ entry.drop.dropModbyStat }}</span>{% endif %}
      {% if entry.stackRandomizerCode %}
        {% set containerParts = entry.stackRandomizerCode.split(':') %}
        <span class="tag">from <a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ containerParts[0] }}/{{ containerParts[1] | slugify }}/">{{ generated.items | displayName(containerParts[0], containerParts[1]) }}</a></span>
      {% endif %}
    </td>
  </tr>
{% endfor %}
{% endcall %}
{% else %}
<p class="muted">No known drops catalogued for this creature.</p>
{% endif %}

{% set npcDialogue = generated.dialogueById[source.id] %}
{% if npcDialogue.id %}
<h2>Dialogue</h2>
<p class="muted">
  From <code>config/dialogue/{{ npcDialogue.dialogueFile }}.json</code> &mdash; this is a branching
  conversation tree, not a fixed script, so these are every line this NPC's side of the
  conversation can say across all of its branches, not one fixed order.
</p>
{% if npcDialogue.lines.length %}
<ul>
{% for line in npcDialogue.lines %}
  <li>{{ line | replace("__LANG__", ('/' ~ lang ~ '/') | url) }}</li>
{% endfor %}
</ul>
{% endif %}
{% if npcDialogue.rewards.length %}
<h3>Can give as a reward ({{ npcDialogue.rewards.length }})</h3>
<table>
  <thead><tr><th>Item</th><th>Stack size</th></tr></thead>
  <tbody>
{% for reward in npcDialogue.rewards %}
  <tr>
    <td><a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ reward.domain }}/{{ reward.code | slugify }}/">{{ generated.items | displayName(reward.domain, reward.code) }}</a></td>
    <td>{% if reward.stacksize %}&times;{{ reward.stacksize }}{% endif %}</td>
  </tr>
{% endfor %}
  </tbody>
</table>
{% endif %}
{% endif %}
