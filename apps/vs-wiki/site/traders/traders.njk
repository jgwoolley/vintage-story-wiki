---
pagination:
  data: generated.trades
  size: 1
  alias: trade
permalink: "{{ lang }}/traders/{{ trade.id | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ trade.displayName }} - Vintage Story Wiki"
---
{% import "macros/itemlink.njk" as il %}
{% import "macros/datatable.njk" as dt %}
{% import "macros/breadcrumb.njk" as bc %}
{{ bc.trail(lang, [{label: "Traders", url: "traders/"}, {label: trade.displayName}]) }}

<h1>{{ trade.displayName }}</h1>
<p class="muted">
  {% if trade.moneyAvg != null %}Starts with {{ trade.moneyAvg }}{% if trade.moneyVar %} &plusmn; {{ trade.moneyVar }}{% endif %} coins to spend.{% endif %}
  &middot; from <a href="{{ ('/' ~ lang ~ '/') | url }}mods/">{{ trade.sourceMod }}</a>
</p>
{% if trade.traderEntities.length %}
<p class="muted">
  Trader entity variants using this specialization (resolved from the entity's own
  <code>variantgroups</code>, not an explicit field):
  {% for e in trade.traderEntities %}<a class="tag" href="{{ ('/' ~ lang ~ '/') | url }}creatures/{{ e.domain }}/{{ e.code | slugify }}/">{{ e.code }}</a>{% endfor %}
</p>
{% endif %}

<h2>Selling ({{ trade.selling.length }})</h2>
{% call dt.datatable(20, "Search what this trader sells...", ["Item", "Price min (per stack)", "Price max (per stack)", "Stock min (stacks)", "Stock max (stacks)", "Items per stack"]) %}
{% for listing in trade.selling %}
  <tr data-search="{{ listing.code }}">
    <td>{% if listing.clutterType %}{% set clutterItem = generated.clutter | findById(listing.clutterType) %}<a href="{{ ('/' ~ lang ~ '/') | url }}clutter/{{ listing.clutterType | slugify }}/">{{ clutterItem.displayName or listing.clutterType }}</a> <span class="muted">(clutter)</span>{% else %}{{ il.link(lang, generated.items, listing.domain, listing.code) }}{% endif %}</td>
    <td>{% if listing.priceMin != null %}{{ listing.priceMin | round(2) }}{% endif %}</td>
    <td>{% if listing.priceMax != null %}{{ listing.priceMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMin != null %}{{ listing.stockMin | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMax != null %}{{ listing.stockMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stacksize %}{{ listing.stacksize }}{% endif %}</td>
  </tr>
{% endfor %}
{% endcall %}

<h2>Buying ({{ trade.buying.length }})</h2>
{% call dt.datatable(20, "Search what this trader buys...", ["Item", "Price min (per stack)", "Price max (per stack)", "Stock min (stacks)", "Stock max (stacks)", "Items per stack"]) %}
{% for listing in trade.buying %}
  <tr data-search="{{ listing.code }}">
    <td>{% if listing.clutterType %}{% set clutterItem = generated.clutter | findById(listing.clutterType) %}<a href="{{ ('/' ~ lang ~ '/') | url }}clutter/{{ listing.clutterType | slugify }}/">{{ clutterItem.displayName or listing.clutterType }}</a> <span class="muted">(clutter)</span>{% else %}{{ il.link(lang, generated.items, listing.domain, listing.code) }}{% endif %}</td>
    <td>{% if listing.priceMin != null %}{{ listing.priceMin | round(2) }}{% endif %}</td>
    <td>{% if listing.priceMax != null %}{{ listing.priceMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMin != null %}{{ listing.stockMin | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMax != null %}{{ listing.stockMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stacksize %}{{ listing.stacksize }}{% endif %}</td>
  </tr>
{% endfor %}
{% endcall %}
