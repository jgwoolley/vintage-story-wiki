---
pagination:
  data: generated.paintings
  size: 1
  alias: item
permalink: "{{ lang }}/paintings/{{ item.domain }}/{{ item.code | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ item.displayName }} - Vintage Story Wiki"
---
{% import "macros/breadcrumb.njk" as bc %}
{{ bc.trail(lang, [{label: "Paintings", url: "paintings/"}, {label: item.displayName}]) }}

<h1>{{ item.displayName }}</h1>
<p class="muted">
  <code>{{ item.domain }}:{{ item.code }}</code>
  &middot; from <a href="{{ ('/' ~ lang ~ '/') | url }}mods/">{{ item.sourceMod }}</a>
</p>

{% if item.description %}
<div class="card">{{ item.description | safe }}</div>
{% else %}
<p class="muted">Paintings have no flavor text in the base game.</p>
{% endif %}

<h2>Found in structures ({{ item.foundInStructures.length }})</h2>
{% if item.foundInStructures.length %}
<table>
  <thead><tr><th>Structure</th><th>Kind</th></tr></thead>
  <tbody>
  {% for structureId in item.foundInStructures %}
    {% set structure = generated.structures | findById(structureId) %}
    {% if structure.id %}
    <tr>
      <td><a href="{{ ('/' ~ lang ~ '/') | url }}structures/{{ structure.id | slugify }}/">{{ structure.name or structure.code }}</a></td>
      <td><span class="tag">{{ structure.kind }}</span></td>
    </tr>
    {% endif %}
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="muted">Not found inside any decoded structure schematic.</p>
{% endif %}
