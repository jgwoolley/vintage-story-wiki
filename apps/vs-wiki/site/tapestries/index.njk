{% import "macros/datatable.njk" as dt %}
{% import "macros/breadcrumb.njk" as bc %}
{{ bc.trail(lang, [{label: "Tapestries"}]) }}
<h1>Tapestries</h1>
<p class="muted">
  Every real possible tapestry a generated structure could show, decoded directly from each
  worldgen schematic's own block-entity data &mdash; one row per (structure, possible tapestry)
  pairing, not per block code or wall direction. Source:
  <code>worldgen/schematics/**/*.json</code>'s <code>BlockEntities</code> (see
  <a href="{{ ('/' ~ lang ~ '/') | url }}info/">Info</a> for how this is decoded).
  <a href="{{ ('/' ~ lang ~ '/') | url }}sources/tapestries/">Full details &rarr;</a>
</p>
<p class="muted">
  <strong>This is a possibility list, not a guarantee.</strong> The game rerolls a schematic's
  authored tapestry to a uniformly random member of the same theme group when it's actually placed
  into a world (unless the schematic pins it), and separately: roughly <strong>60% of the time a
  given placement doesn't spawn at all</strong>, and of the ~40% that do, roughly
  <strong>75% turn out rotten</strong> (no name, no lore, no drop -- just "Rotten Tapestry"). So
  for any one row below, the realistic odds are roughly 60% nothing, ~30% a rotten blank, and ~10%
  that specific tapestry, discoverable.
</p>

{% call dt.datatable(60, "Search ruin, tapestry, or block code...", ["Ruin", "Ruin mod", "Tapestry", "Lore chapter", "Attribute", "Block", "Direction", "Size", "Authored"]) %}
{% for item in generated.tapestries %}
  {% set book = generated.lore | findById(item.relatedLoreBookId) %}
  {% for inst in item.tapestryInstances | default([]) %}
    {% set structure = generated.structures | findById(inst.structureId) %}
    {% if structure %}
      {% for outcome in inst.outcomes %}
        <tr data-search="{{ structure.name or structure.code }} {{ outcome.displayName }} {{ outcome.rawType }} {{ inst.blockCode }}" data-category="{{ inst.blockCode.split('-').pop() }}" data-mod="{{ structure.sourceMod }}" data-mod-label="{{ generated.mods | modName(structure.sourceMod) }}">
          <td><a href="{{ ('/' ~ lang ~ '/') | url }}structures/{{ structure.id | slugify }}/">{{ structure.name or structure.code }}</a> <span class="tag">{{ structure.kind }}</span></td>
          <td><span class="tag">{{ structure.sourceMod }}</span></td>
          <td>{{ outcome.displayName }}</td>
          <td>
            {% if book.id and outcome.loreChapterId != null %}
              <a href="{{ ('/' ~ lang ~ '/') | url }}lore/{{ book.domain }}/{{ book.code | slugify }}/#chapter-{{ outcome.loreChapterId }}">{{ book.title }} &mdash; ch. {{ outcome.loreChapterId + 1 }}</a>
            {% else %}
              <span class="muted">no lore</span>
            {% endif %}
          </td>
          <td><code>{{ outcome.rawType }}</code></td>
          <td><code>{{ inst.blockCode }}</code></td>
          <td>{{ inst.blockCode.split('-').pop() }}</td>
          <td>{{ outcome.size or "" }}</td>
          <td>{% if outcome.baseCode == inst.storedBaseCode %}<span class="tag">authored</span>{% endif %}</td>
        </tr>
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% endcall %}
