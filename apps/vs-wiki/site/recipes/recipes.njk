---
pagination:
  data: generated.recipes
  size: 1
  alias: recipe
permalink: "{{ lang }}/recipes/{{ recipe.category }}/{{ recipe.id | slugify }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ recipe | recipeTitle(generated.items) | safe }} - Vintage Story Wiki"
---
{% import "macros/itemlink.njk" as il %}
{% import "macros/breadcrumb.njk" as bc %}
{{ bc.trail(lang, [{label: "Recipes", url: "recipes/"}, {label: recipe | recipeTitle(generated.items)}]) }}

<h1>{{ recipe | recipeTitle(generated.items) }}</h1>
{% if not recipe.name %}<p class="muted">This category has no recipe names of its own in the game data &mdash; titled here after its output item.</p>{% endif %}
<p class="muted">
  <span class="tag">{{ recipe.category }}</span>
  {% if recipe.shapeless %}<span class="tag">shapeless</span>{% endif %}
  from <a href="{{ ('/' ~ lang ~ '/') | url }}mods/">{{ recipe.sourceMod }}</a>
  {% if recipe.sealHours %}&middot; seals for {{ recipe.sealHours }}h{% endif %}
</p>

{% if recipe.category == "grid" %}
  {% set rows = recipe.raw.ingredientPattern.split(",") %}
  <div class="recipe-grid" style="grid-template-columns: repeat({{ recipe.width }}, 56px);">
    {% for row in rows %}
      {% for ch in row %}
        {% if ch == "_" %}
          <div class="cell empty"></div>
        {% else %}
          {% set ing = recipe.ingredientsBySlot[ch] %}
          <div class="cell" title="{{ ing.code or (ing.tags | default([]) | join(', ')) }}">
            {% if ing.code %}
              {% if "*" in ing.code or "{" in ing.code %}
                {{ il.link(lang, generated.items, ing.domain, ing.code) }}
              {% else %}
                {{ il.link(lang, generated.items, ing.domain, ing.code) }}
              {% endif %}
            {% elif ing.tags %}{% for t in ing.tags %}<a href="{{ ('/' ~ lang ~ '/') | url }}items/?tag={{ t | urlencode }}">{{ t | tagLabel }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
{% elif recipe.category == "smithing" or recipe.category == "clayforming" or recipe.category == "knapping" %}
  {% set layerCount = recipe.raw.pattern.length %}
  <div class="layer-switcher voxel-recipe pattern-viewer" data-category="{{ recipe.category }}">
    {#- One container: a toolbar (view / 3D layer mode / layer tabs) over a stage showing exactly one
        of the 3D model (assets/recipeVoxels.js on the shared core assets/voxelViewer.js) or the 2D
        per-layer slice grids. Controls that don't apply in the current state are disabled, never
        hidden, so the layer tabs sit in the same place in both views. Without JS/WebGL the
        view/mode rows stay hidden and the 2D view is all there is; the layer tabs still work. -#}
    <div class="pattern-toolbar">
      <div class="pattern-toolbar-row voxel-controls" hidden>
        <div class="pattern-group">
          <span class="pattern-group-label">View</span>
          <div class="segmented" role="group" aria-label="View">
            <button type="button" class="layer-tab" data-view="3d">3D model</button>
            <button type="button" class="layer-tab" data-view="2d">2D layers</button>
          </div>
        </div>
        {% if layerCount > 1 %}
        <div class="pattern-group voxel-modes">
          <span class="pattern-group-label">Show</span>
          <div class="segmented" role="group" aria-label="Layers shown in 3D">
            <button type="button" class="layer-tab" data-mode="all">All layers</button>
            <button type="button" class="layer-tab" data-mode="single">One layer</button>
            <button type="button" class="layer-tab" data-mode="below">Layer N and below</button>
          </div>
        </div>
        <div class="pattern-group">
          <span class="pattern-group-label">Auto-play</span>
          <div class="segmented" role="group" aria-label="Automatically step through layers">
            <button type="button" class="layer-tab voxel-autoplay" aria-pressed="false">&#9654; Play</button>
            <select class="voxel-autoplay-speed" aria-label="Seconds per layer">
              <option value="1000">1s</option>
              <option value="2000" selected>2s</option>
              <option value="4000">4s</option>
            </select>
          </div>
        </div>
        {% endif %}
      </div>
      <div class="pattern-toolbar-row">
        <div class="pattern-group">
          <span class="pattern-group-label">Layer</span>
          {% if layerCount > 1 %}
          <div class="segmented layer-tabs" role="group" aria-label="Layer">
            {% for layer in recipe.raw.pattern %}
              <button type="button" class="layer-tab{% if loop.first %} active{% endif %}" data-layer-index="{{ loop.index0 }}">{{ loop.index }}</button>
            {% endfor %}
          </div>
          {% else %}
          <span class="muted">1 (single-layer pattern)</span>
          {% endif %}
        </div>
      </div>
    </div>
    <div class="pattern-stage">
      <div class="voxel-viewer" hidden>
        <div class="voxel-viewer-canvas" aria-label="3D view of the {{ recipe.category }} pattern for {{ recipe | recipeTitle(generated.items) }}"></div>
        <div class="voxel-viewer-bar">
          <span class="muted">Drag to rotate &middot; scroll/pinch to zoom &middot; right-drag to pan</span>
          <button type="button" class="layer-tab voxel-viewer-reset">Reset view</button>
        </div>
      </div>
      <div class="layer-slices">
        {% for layer in recipe.raw.pattern %}
          <div class="layer-panel voxel-slice" data-layer-index="{{ loop.index0 }}" style="--cols: {{ layer[0].length }};" {% if not loop.first %}hidden{% endif %}>
            {%- for row in layer %}{% for ch in row %}<i{% if ch == "#" %} class="on"{% endif %}></i>{% endfor %}{% endfor -%}
          </div>
        {% endfor %}
      </div>
    </div>
    <script type="application/json" class="voxel-pattern">{{ recipe.raw.pattern | dump | safe }}</script>
  </div>
  <script type="module" src="{{ '/' | url }}assets/recipeVoxels.js"></script>
{% endif %}

<h2>Ingredients</h2>
<table>
  <thead><tr><th>Slot</th><th>Item</th><th>Qty / Ratio</th><th>Notes</th></tr></thead>
  <tbody>
  {% for ing in recipe.ingredients %}
    <tr>
      <td>{{ ing.slotKey or ing.code }}</td>
      <td>
        {% if ing.code %}
          {% if "*" in ing.code or "{" in ing.code %}
            {{ il.link(lang, generated.items, ing.domain, ing.code) }}{% if ing.name %} ({{ ing.name }}){% endif %}
          {% else %}
            {{ il.link(lang, generated.items, ing.domain, ing.code) }}
          {% endif %}
        {% elif ing.tags %}
          any {% for t in ing.tags %}<a class="tag" href="{{ ('/' ~ lang ~ '/') | url }}items/?tag={{ t | urlencode }}">{{ t | tagLabel }}</a>{% endfor %}
        {% elif ing.validStacks %}
          {% for v in ing.validStacks %}{{ il.link(lang, generated.items, v.domain, v.code) }}{% if not loop.last %} or {% endif %}{% endfor %}
        {% endif %}
      </td>
      <td>
        {% if ing.minratio != null %}{{ ing.minratio | percent }}&ndash;{{ ing.maxratio | percent }}{% endif %}
        {% if ing.quantity %}&times;{{ ing.quantity }}{% endif %}
        {% if ing.litres %}{{ ing.litres }}L{% endif %}
        {% if ing.minQuantity %}{{ ing.minQuantity }}&ndash;{{ ing.maxQuantity }}{% endif %}
      </td>
      <td>
        {% if ing.isTool %}uses {{ ing.toolDurabilityCost }} durability{% endif %}
        {% if ing.allowedVariants %}any of: {{ ing.allowedVariants | join(", ") }}{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Output</h2>
<p>
  {% if recipe.output.code %}
    {% if "{" in recipe.output.code %}
      {{ il.link(lang, generated.items, recipe.output.domain, recipe.output.code) }}{% if recipe.wildcard %} (depends on <strong>{{ recipe.wildcard.placeholder }}</strong>){% endif %}
    {% else %}
      {{ il.link(lang, generated.items, recipe.output.domain, recipe.output.code) }}
    {% endif %}
  {% endif %}
  {% if recipe.output.quantity %}&times;{{ recipe.output.quantity }}{% endif %}
  {% if recipe.output.litres %}{{ recipe.output.litres }}L{% endif %}
</p>

{% if recipe.wildcard %}
<h3>Resolved variants</h3>
<table>
  <thead><tr><th>{{ recipe.wildcard.placeholder }}</th><th>Output</th></tr></thead>
  <tbody>
  {% for variant in recipe.wildcard.allowedVariants %}
    <tr>
      <td>{{ variant }}</td>
      <td>{{ recipe.output.code | replace("{" + recipe.wildcard.placeholder + "}", variant) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if recipe.templateVariants %}
<h3>Variant placeholders</h3>
<p class="muted">Ingredients and output above use <code>{placeholder}</code> tokens; any combination of these is valid.</p>
<table>
  <thead><tr><th>Placeholder</th><th>Allowed values</th></tr></thead>
  <tbody>
  {% for placeholder, values in recipe.templateVariants %}
    <tr><td>{{ placeholder }}</td><td>{{ values | join(", ") }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

<details>
  <summary class="muted">Raw recipe JSON</summary>
  <pre>{{ recipe.raw | json }}</pre>
</details>
