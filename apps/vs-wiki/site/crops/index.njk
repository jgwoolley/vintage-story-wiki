title: Crops - Vintage Story Wiki
layout: layouts/base.njk
permalink: "{{ lang }}/crops/index.html"
---
{% import "macros/itemlink.njk" as il %}
{% import "macros/datatable.njk" as dt %}
{% import "macros/breadcrumb.njk" as bc %}
{% import "macros/temperature.njk" as tmp %}
{{ bc.trail(lang, [{label: "Crops"}]) }}
<h1>Crops</h1>
<p class="muted">
  Where wild crops/flowers/mushrooms/etc. naturally occur, read directly from the game's worldgen
  rules. See also <a href="{{ ('/' ~ lang ~ '/') | url }}trees/">Trees</a> and
  <a href="{{ ('/' ~ lang ~ '/') | url }}deposits/">Deposits</a> for the other two spawn-only
  content types.
</p>
<p class="muted">
  Climate ranges below are the raw worldgen rule the game checks, not a guarantee -- these are the
  conditions a <em>chunk</em> must meet, not a promise any single spot within it generates
  something.
</p>
<p class="muted">
  Crop rows also show the soil <strong>nutrient</strong> (N nitrogen / P phosphorus / K potassium)
  the crop draws on, how much one cycle uses, and its total growth time, from each crop's
  <code>cropProps</code> in <code>blocktypes/plant/crop/</code>. Click a column header to sort, or
  use the Tags filter to show one nutrient.
</p>
<p class="muted">Source: <code>worldgen/blockpatches/*.json</code> + <code>blocktypes/plant/crop/*.json</code>. <a href="{{ ('/' ~ lang ~ '/') | url }}sources/crops/">Full details &rarr;</a></p>

<h2>Crops / flowers / mushrooms / etc. ({{ generated.blockPatches.length }})</h2>
{% call dt.datatable(40, "Search spawn patches...", ["Blocks", "Category", "Nutrient", "Nutrient use", "Growth (months)", "Temp (°C)", "Rain", "Mod"]) %}
{% for patch in generated.blockPatches | sort(false, false, "category") %}
  <tr data-search="{{ patch.blockCodes | join(' ') }}" data-category="{{ patch.category }}"{% if patch.crop.requiredNutrient %} data-tags="nutrient-{{ patch.crop.requiredNutrient | lower }}"{% endif %} data-mod="{{ patch.sourceMod }}" data-mod-label="{{ generated.mods | modName(patch.sourceMod) }}">
    <td>{% for c in patch.blockCodes %}{{ il.link(lang, generated.items, patch.domain, c) }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
    <td><span class="tag">{{ patch.category }}</span></td>
    <td>{% if patch.crop.requiredNutrient %}<span class="tag" title="{{ {N: 'Nitrogen', P: 'Phosphorus', K: 'Potassium'}[patch.crop.requiredNutrient] or patch.crop.requiredNutrient }}">{{ patch.crop.requiredNutrient }}</span> {{ {N: 'Nitrogen', P: 'Phosphorus', K: 'Potassium'}[patch.crop.requiredNutrient] }}{% endif %}</td>
    <td>{% if patch.crop.nutrientConsumption != null %}{{ patch.crop.nutrientConsumption }}{% endif %}</td>
    <td>{% if patch.crop.totalGrowthMonths != null %}{{ patch.crop.totalGrowthMonths }}{% endif %}</td>
    <td>{{ tmp.range(patch.minTemp, patch.maxTemp) }}</td>
    <td>{% if patch.minRain != null or patch.maxRain != null %}{{ patch.minRain if patch.minRain != null else 0 }}&ndash;{{ patch.maxRain if patch.maxRain != null else 1 }}{% endif %}</td>
    <td><span class="tag">{{ patch.sourceMod }}</span></td>
  </tr>
{% endfor %}
{% endcall %}
