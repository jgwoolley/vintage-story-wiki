---
title: Trades - Vintage Story Wiki
description: Every item wandering traders buy and sell, flattened into one sortable table.
layout: layouts/base.njk
permalink: "{{ lang }}/trades/index.html"
---
{% import "macros/datatable.njk" as dt %}
{% import "macros/breadcrumb.njk" as bc %}
{{ bc.trail(lang, [{label: "Trades"}]) }}
<h1>Trades</h1>
<p class="muted">
  Every individual buy/sell listing across every wandering trader specialization, in one flat
  table -- filter by direction (selling/buying) or mod and sort any column. Price is per
  <em>stack</em>, and stock is how many stacks a trader offers, each holding "Items per stack"
  items; min/max are the average &plusmn; variance from the game data. To browse by trader
  instead (starting coins, what each one buys and sells, which entities use it), see
  <a href="{{ ('/' ~ lang ~ '/') | url }}traders/">Traders</a>.
</p>
<p class="muted">Source: <code>config/tradelists/trader-&lt;specialization&gt;.json</code>. <a href="{{ ('/' ~ lang ~ '/') | url }}sources/trades/">Full details &rarr;</a></p>

{% call dt.datatable(60, "Search traded items or specializations...", ["Item", "Trader", "Direction", "Price min (per stack)", "Price max (per stack)", "Stock min (stacks)", "Stock max (stacks)", "Items per stack", "Mod"]) %}
{% for trade in generated.trades | sort(false, false, "id") %}
  {% for listing in trade.selling %}
  <tr data-search="{{ listing.domain }}:{{ listing.code }} {{ generated.items | displayName(listing.domain, listing.code) }} {{ trade.id }}" data-category="{{ listing.direction }}" data-mod="{{ trade.sourceMod }}" data-mod-label="{{ generated.mods | modName(trade.sourceMod) }}">
    <td>{% if listing.clutterType %}{% set clutterItem = generated.clutter | findById(listing.clutterType) %}<a href="{{ ('/' ~ lang ~ '/') | url }}clutter/{{ listing.clutterType | slugify }}/">{{ clutterItem.displayName or listing.clutterType }}</a> <span class="muted">(clutter)</span>{% else %}<a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ listing.domain }}/{{ listing.code | slugify }}/">{{ generated.items | displayName(listing.domain, listing.code) }}</a>{% endif %}</td>
    <td>
      <a href="{{ ('/' ~ lang ~ '/') | url }}traders/{{ trade.id | slugify }}/">{{ trade.displayName }}</a>
      {% if trade.traderEntities.length %} <a class="tag" href="{{ ('/' ~ lang ~ '/') | url }}creatures/{{ trade.traderEntities[0].domain }}/{{ trade.traderEntities[0].code | slugify }}/" title="{{ trade.traderEntities.length }} matching trader entity variant(s)">entity</a>{% endif %}
    </td>
    <td>Selling</td>
    <td>{% if listing.priceMin != null %}{{ listing.priceMin | round(2) }}{% endif %}</td>
    <td>{% if listing.priceMax != null %}{{ listing.priceMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMin != null %}{{ listing.stockMin | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMax != null %}{{ listing.stockMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stacksize %}{{ listing.stacksize }}{% endif %}</td>
    <td><span class="tag">{{ trade.sourceMod }}</span></td>
  </tr>
  {% endfor %}
  {% for listing in trade.buying %}
  <tr data-search="{{ listing.domain }}:{{ listing.code }} {{ generated.items | displayName(listing.domain, listing.code) }} {{ trade.id }}" data-category="{{ listing.direction }}" data-mod="{{ trade.sourceMod }}" data-mod-label="{{ generated.mods | modName(trade.sourceMod) }}">
    <td>{% if listing.clutterType %}{% set clutterItem = generated.clutter | findById(listing.clutterType) %}<a href="{{ ('/' ~ lang ~ '/') | url }}clutter/{{ listing.clutterType | slugify }}/">{{ clutterItem.displayName or listing.clutterType }}</a> <span class="muted">(clutter)</span>{% else %}<a href="{{ ('/' ~ lang ~ '/') | url }}items/{{ listing.domain }}/{{ listing.code | slugify }}/">{{ generated.items | displayName(listing.domain, listing.code) }}</a>{% endif %}</td>
    <td>
      <a href="{{ ('/' ~ lang ~ '/') | url }}traders/{{ trade.id | slugify }}/">{{ trade.displayName }}</a>
      {% if trade.traderEntities.length %} <a class="tag" href="{{ ('/' ~ lang ~ '/') | url }}creatures/{{ trade.traderEntities[0].domain }}/{{ trade.traderEntities[0].code | slugify }}/" title="{{ trade.traderEntities.length }} matching trader entity variant(s)">entity</a>{% endif %}
    </td>
    <td>Buying</td>
    <td>{% if listing.priceMin != null %}{{ listing.priceMin | round(2) }}{% endif %}</td>
    <td>{% if listing.priceMax != null %}{{ listing.priceMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMin != null %}{{ listing.stockMin | round(2) }}{% endif %}</td>
    <td>{% if listing.stockMax != null %}{{ listing.stockMax | round(2) }}{% endif %}</td>
    <td>{% if listing.stacksize %}{{ listing.stacksize }}{% endif %}</td>
    <td><span class="tag">{{ trade.sourceMod }}</span></td>
  </tr>
  {% endfor %}
{% endfor %}
{% endcall %}
