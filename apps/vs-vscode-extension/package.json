{
  "name": "vs-vscode-extension",
  "displayName": "Nf3t's Vintage Story Tools",
  "description": "Preview Vintage Story worldgen schematics (.json / .json.gz), item/creature/block model files and ChiselTools chiseled-block shapes as interactive 3D models.",
  "version": "0.1.0",
  "icon": "icon.png",
  "private": true,
  "author": "Nf3t (https://github.com/jgwoolley)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgwoolley/vintage-story-wiki.git",
    "directory": "apps/vs-vscode-extension"
  },
  "homepage": "https://github.com/jgwoolley/vintage-story-wiki#readme",
  "bugs": {
    "url": "https://github.com/jgwoolley/vintage-story-wiki/issues"
  },
  "publisher": "vintage-story-wiki",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "vintage story",
    "schematic",
    "model",
    "shape",
    "voxel",
    "preview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vsSchematic.preview",
        "displayName": "Nf3t's Vintage Story Tools",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.json.gz"
          },
          {
            "filenamePattern": "*.pf"
          },
          {
            "filenamePattern": "**/chiselportfolio/*"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Nf3t's Vintage Story Tools",
      "properties": {
        "vsSchematic.showCenterMarker": {
          "type": "boolean",
          "default": false,
          "description": "Show a marker (a magenta dot with red/green/blue axes) at the center of the previewed shape: the point the camera orbits."
        },
        "vsSchematic.showGrid": {
          "type": "boolean",
          "default": false,
          "description": "Show a grid on the y = 0 plane (the bottom of the lowest row of blocks) in the preview."
        },
        "vsSchematic.gameFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Vintage Story **game client** install folder (the one with `assets/survival/textures`), or its `assets` folder. Model previews load their textures from it. The dedicated server download has almost no textures, so it won't do. Use **Vintage Story: Select Game Folder** to pick and check it."
        }
      }
    },
    "commands": [
      {
        "command": "vsSchematic.selectGameFolder",
        "title": "Select Game Folder (for model textures)",
        "category": "Vintage Story"
      },
      {
        "command": "vsSchematic.openPreview",
        "title": "Preview Schematic, Model or Chisel Shape",
        "category": "Vintage Story"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vsSchematic.openPreview",
          "when": "resourceFilename =~ /\\.(json(\\.gz)?|pf)$/ || resourcePath =~ /chiselportfolio/",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/webview/tsconfig.json",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "three": "0.180.0",
    "@nf3t/vs-schematic": "*"
  }
}
